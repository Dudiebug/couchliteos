# Surface Laptop 7 (Snapdragon X Elite, X1E80100) on top of Debian's arm64 config.
# Merged by build.sh; every line here must survive olddefconfig or the build fails.

# Touch: the HID-over-SPI transport (patches/0002, from ELLX) for the touchpad and the
# 15-inch touchscreen; HID-over-I2C for the 13.8-inch touchscreen (patches/0100).
CONFIG_SPI_HID=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_I2C_QCOM_GENI=m
CONFIG_I2C_HID_OF=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_GENERIC=m

# SoC
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_X1E80100=y
CONFIG_CLK_X1E80100_GCC=y
CONFIG_CLK_X1E80100_DISPCC=m
CONFIG_CLK_X1E80100_GPUCC=m
CONFIG_CLK_X1E80100_TCSRCC=m
CONFIG_CLK_X1E80100_CAMCC=m
CONFIG_INTERCONNECT_QCOM_X1E80100=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_LMH=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QCOM_APR=m
CONFIG_QCOM_FASTRPC=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SCM=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_INPUT_PM8941_PWRKEY=m
CONFIG_POWER_RESET_QCOM_PON=m
CONFIG_RTC_DRV_PM8XXX=m
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y

# Storage and buses
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=m
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_PHY_QCOM_QMP_USB=m
CONFIG_PHY_QCOM_EUSB2_REPEATER=m
CONFIG_PHY_QCOM_EDP=m
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_QCOM=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_TYPEC_MUX_PS883X=m
CONFIG_USB_ONBOARD_DEV=m
CONFIG_BLK_DEV_NVME=y

# Display, GPU, video decode
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_PANEL_EDP=m
CONFIG_DRM_DISPLAY_CONNECTOR=m
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_OV02C10=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Wi-Fi and Bluetooth (WCN7850)
CONFIG_ATH12K=m
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_SERIAL_DEV_BUS=y

# Audio
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_X1E80100=m
CONFIG_SND_SOC_QCOM_SDW=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_WSA884X=m
CONFIG_SND_SOC_WCD939X=m
CONFIG_SND_SOC_WCD939X_SDW=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SOUNDWIRE_QCOM=m

# Surface EC (keyboard backlight, battery, posture events: patches/0020)
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_KBD=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m

# Crypto engine (patches/0026 and 0027 make it safe to enable)
CONFIG_CRYPTO_DEV_QCE=m

# Build: no debug info, no Debian signing keys (modules get a build-time key). The PMIC
# drivers are modules in Debian's config (SPMI is), so they stay modules here.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_SYSTEM_TRUSTED_KEYS=""
