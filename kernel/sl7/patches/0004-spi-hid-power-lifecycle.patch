+		shid->panel_follower.funcs = &spi_hid_panel_funcs;
+		device_set_wakeup_capable(dev, false);
+		ret = drm_panel_add_follower(dev, &shid->panel_follower);
+		if (ret)
+			goto err_power;
+		shid->follower_registered = true;
+	} else {
+		mutex_lock(&shid->power_lock);
+		ret = spi_hid_start(shid);
+		mutex_unlock(&shid->power_lock);
+		if (ret)
+			goto err_power;
+	}
 
 	return 0;
 
+err_power:
+	spi_hid_power_down(shid);
+err_irq:
+	free_irq(spi->irq, shid);
 err_sysfs:
 	sysfs_remove_files(&dev->kobj, spi_hid_attributes);
 err_free:
@@ -998,20 +1168,30 @@
 	return ret;
 }
 
+static void spi_hid_shutdown(struct spi_device *spi)
+{
+	struct spi_hid *shid = spi_get_drvdata(spi);
+	int ret;
+
+	if (shid->follower_registered) {
+		drm_panel_remove_follower(&shid->panel_follower);
+		shid->follower_registered = false;
+	}
+	cancel_work_sync(&shid->panel_work);
+	mutex_lock(&shid->power_lock);
+	ret = spi_hid_stop(shid);
+	mutex_unlock(&shid->power_lock);
+	if (ret)
+		dev_err(&spi->dev, "Failed to power down: %d\n", ret);
+}
