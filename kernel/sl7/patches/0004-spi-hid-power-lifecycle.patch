 };
 
+/* Call with power_lock held. A fresh HID child lets hidraw clients restore
+ * their device mode after reset, rather than leaving iptsd on a stale stream.
+ */
+static int spi_hid_start(struct spi_hid *shid)
+{
+	int ret;
+
+	if (!READ_ONCE(shid->stopping))
+		return 0;
+	ret = spi_hid_power_up(shid);
+	if (ret)
+		return ret;
+	shid->ready = false;
+	shid->attempts = 0;
+	shid->rd_len = 0;
+	shid->power_state = SPI_HID_POWER_MODE_ACTIVE;
+	WRITE_ONCE(shid->stopping, false);
+	enable_irq(shid->spi->irq);
+	shid->irq_enabled = true;
+	dev_info(&shid->spi->dev, "SL7 power on; waiting for HID enumeration\n");
+	return 0;
+}
+
+/* Stop requests/IRQs and all enumeration work before changing GPIOs. */
+static int spi_hid_stop(struct spi_hid *shid)
+{
+	int ret;
+
+	WRITE_ONCE(shid->stopping, true);
+	if (shid->irq_enabled) {
+		disable_irq(shid->spi->irq);
+		shid->irq_enabled = false;
+	}
+	complete_all(&shid->output_done);
+	cancel_work_sync(&shid->reset_work);
+	cancel_work_sync(&shid->create_device_work);
+	cancel_work_sync(&shid->refresh_device_work);
+	spi_hid_stop_hid(shid);
+	/* Synchronize any remaining raw request before removing power. */
+	mutex_lock(&shid->lock);
+	shid->ready = false;
+	shid->power_state = SPI_HID_POWER_MODE_OFF;
+	ret = spi_hid_power_down(shid);
+	mutex_unlock(&shid->lock);
+	if (!ret)
+		dev_info(&shid->spi->dev, "SL7 reset asserted; supply released\n");
+	return ret;
+}
+
+static void spi_hid_panel_work(struct work_struct *work)
+{
+	struct spi_hid *shid = container_of(work, struct spi_hid, panel_work);
+	int ret;
+
+	mutex_lock(&shid->power_lock);
+	ret = spi_hid_start(shid);
+	mutex_unlock(&shid->power_lock);
+	if (ret)
+		dev_err(&shid->spi->dev, "Panel touch resume failed: %d\n", ret);
+}
+
+static int spi_hid_panel_on(struct drm_panel_follower *follower)
+{
+	struct spi_hid *shid = container_of(follower, struct spi_hid, panel_follower);
+
+	/* Do not delay display enable or enumerate children until thaw. */
+	queue_work(system_freezable_wq, &shid->panel_work);
+	return 0;
+}
+
+static int spi_hid_panel_off(struct drm_panel_follower *follower)
+{
+	struct spi_hid *shid = container_of(follower, struct spi_hid, panel_follower);
+	int ret;
+
+	cancel_work_sync(&shid->panel_work);
+	mutex_lock(&shid->power_lock);
+	ret = spi_hid_stop(shid);
+	mutex_unlock(&shid->power_lock);
+	return ret;
+}
+
+static const struct drm_panel_follower_funcs spi_hid_panel_funcs = {
+	.panel_enabled = spi_hid_panel_on,
+	.panel_disabling = spi_hid_panel_off,
+};
+
+static int spi_hid_suspend(struct device *dev)
+{
+	struct spi_hid *shid = dev_get_drvdata(dev);
+	int ret;
+
+	/* The display driver already controls followers during system sleep. */
+	if (shid->is_panel_follower)
+		return 0;
+	mutex_lock(&shid->power_lock);
+	ret = spi_hid_stop(shid);
+	if (ret)
+		spi_hid_start(shid);
+	mutex_unlock(&shid->power_lock);
+	return ret;
+}
+
+static int spi_hid_resume(struct device *dev)
+{
+	struct spi_hid *shid = dev_get_drvdata(dev);
+	int ret;
+
+	if (shid->is_panel_follower)
+		return 0;
+	mutex_lock(&shid->power_lock);
+	ret = spi_hid_start(shid);
+	mutex_unlock(&shid->power_lock);
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(spi_hid_pm_ops, spi_hid_suspend, spi_hid_resume);
+
+static ssize_t power_state_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct spi_hid *shid = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "supply=%u stopping=%u panel_follower=%u\n",
+			 READ_ONCE(shid->powered), READ_ONCE(shid->stopping),
+			 shid->is_panel_follower);
+}
+static DEVICE_ATTR_RO(power_state);
