-
-	enable_irq(spi->irq);
-	shid->irq_enabled = true;
+	/* Controller runtime PM belongs to the SPI controller, not its child. */
+	if (shid->is_panel_follower) {
+		/* Park a boot-enabled rail safely before following display state. */
+		ret = pinctrl_select_state(shid->pinctrl, shid->pinctrl_reset);
+		if (ret)
+			goto err_irq;
+		if (shid->supply) {
+			ret = regulator_enable(shid->supply);
+			if (ret)
+				goto err_irq;
+		}
+		shid->powered = true;
+		ret = spi_hid_power_down(shid);
+		if (ret)
