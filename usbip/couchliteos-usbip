#!/bin/bash
set -Eeuo pipefail

ALLOWLIST=${COUCHLITEOS_USBIP_ALLOWLIST:-/etc/couchliteos/usbip-allowlist.conf}
SYSFS=${COUCHLITEOS_SYSFS_ROOT:-/sys}
LOG=${COUCHLITEOS_USBIP_LOG:-/var/log/couchliteos/usbip.log}
NAV_ID_FILE=/var/lib/couchliteos/launcher-controller.id

log() {
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" | tee -a "$LOG"
}

usage() {
  cat <<'EOF'
Usage: couchliteos-usbip COMMAND [BUSID]
  list          Show USB devices, policy, and binding state
  reconcile     Bind exactly the currently present allowlisted devices
  bind BUSID    Bind one device only if policy allows it
  unbind BUSID  Stop exporting one device
  unbind-all    Stop exporting every device bound to usbip-host
  start         Start usbipd and reconcile
  stop          Unbind all devices and stop usbipd
  status        Show daemon, firewall, and exported-device state
EOF
}

read_value() {
  local path=$1 fallback=${2:-}
  [[ -r "$path" ]] && tr '[:upper:]' '[:lower:]' < "$path" || printf '%s' "$fallback"
}

device_dir() {
  local busid=$1
  local dir="$SYSFS/bus/usb/devices/$busid"
  [[ -d "$dir" && -r "$dir/idVendor" && -r "$dir/idProduct" ]] || return 1
  printf '%s' "$dir"
}

identity() {
  local dir=$1
  printf '%s:%s:%s' \
    "$(read_value "$dir/idVendor")" \
    "$(read_value "$dir/idProduct")" \
    "$(read_value "$dir/serial" '*')"
}

allow_entry() {
  local dir=$1 vid pid serial line rule_vid rule_pid rule_serial flag
  vid=$(read_value "$dir/idVendor")
  pid=$(read_value "$dir/idProduct")
  serial=$(read_value "$dir/serial" '*')
  while IFS= read -r line; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    [[ -z "$line" ]] && continue
    IFS=: read -r rule_vid rule_pid rule_serial flag <<< "$line"
    [[ "$rule_vid" =~ ^[0-9a-f]{4}$ && "$rule_pid" =~ ^[0-9a-f]{4}$ ]] || continue
    [[ "$vid" == "$rule_vid" && "$pid" == "$rule_pid" ]] || continue
    [[ "$rule_serial" == '*' || "$serial" == "${rule_serial,,}" ]] || continue
    printf '%s' "${flag:-normal}"
    return 0
  done < "$ALLOWLIST"
  return 1
}

risky_reason() {
  local dir=$1 iface cls proto
  cls=$(read_value "$dir/bDeviceClass" '00')
  case "$cls" in
    01) echo microphone-or-audio; return 0 ;;
    08) echo storage; return 0 ;;
    0e) echo webcam-or-video; return 0 ;;
  esac
  for iface in "$dir":*; do
    [[ -d "$iface" ]] || continue
    cls=$(read_value "$iface/bInterfaceClass" '00')
    proto=$(read_value "$iface/bInterfaceProtocol" '00')
    case "$cls:$proto" in
      01:*) echo microphone-or-audio; return 0 ;;
      08:*) echo storage; return 0 ;;
      0e:*) echo webcam-or-video; return 0 ;;
      03:01) echo keyboard; return 0 ;;
      03:02) echo mouse; return 0 ;;
    esac
  done
  return 1
}

policy() {
  local dir=$1 entry reason id nav nav_vid nav_pid nav_serial id_vid id_pid id_serial
  id=$(identity "$dir")
  if [[ -r "$NAV_ID_FILE" ]]; then
    nav=$(tr '[:upper:]' '[:lower:]' < "$NAV_ID_FILE")
    IFS=: read -r nav_vid nav_pid nav_serial <<< "$nav"
    IFS=: read -r id_vid id_pid id_serial <<< "$id"
    if [[ "$nav_vid" == "$id_vid" && "$nav_pid" == "$id_pid" ]] && \
       [[ "$nav_serial" == '*' || "$nav_serial" == "$id_serial" ]]; then
      echo 'blocked:launcher-controller'
      return 1
    fi
  fi
  if ! entry=$(allow_entry "$dir"); then
    echo 'blocked:not-allowlisted'
    return 1
  fi
  if reason=$(risky_reason "$dir"); then
    if [[ "$entry" != risky ]]; then
      echo "blocked:$reason-needs-risky-flag"
      return 1
    fi
    echo "allowed:explicit-risky-$reason"
    return 0
  fi
  echo allowed
}

bound() {
  [[ -L "$1/driver" && $(basename "$(readlink -f "$1/driver")") == usbip-host ]]
}

bind_one() {
  local busid=$1 dir result
  dir=$(device_dir "$busid") || { log "refused unknown busid $busid"; return 1; }
  if ! result=$(policy "$dir"); then
    log "refused $busid $(identity "$dir") $result"
    return 1
  fi
  if bound "$dir"; then
    log "$busid already bound ($result)"
    return 0
  fi
  /usr/sbin/usbip bind --busid="$busid"
  log "bound $busid $(identity "$dir") $result"
}

unbind_one() {
  local busid=$1 dir
  dir=$(device_dir "$busid") || return 0
  if bound "$dir"; then
    /usr/sbin/usbip unbind --busid="$busid" || true
    log "unbound $busid"
  fi
}

list_devices() {
  local dir busid result state
  printf '%-12s %-22s %-10s %s\n' BUSID VID:PID:SERIAL STATE POLICY
  for dir in "$SYSFS"/bus/usb/devices/*; do
    [[ -r "$dir/idVendor" && -r "$dir/idProduct" ]] || continue
    busid=${dir##*/}
    if result=$(policy "$dir"); then :; else :; fi
    state=local
    bound "$dir" && state=exported
    printf '%-12s %-22s %-10s %s\n' "$busid" "$(identity "$dir")" "$state" "$result"
  done
}

reconcile() {
  local dir busid result
  modprobe usbip_host
  for dir in "$SYSFS"/bus/usb/devices/*; do
    [[ -r "$dir/idVendor" && -r "$dir/idProduct" ]] || continue
    busid=${dir##*/}
    if result=$(policy "$dir"); then
      bind_one "$busid" || true
    elif bound "$dir"; then
      unbind_one "$busid"
    fi
  done
}

unbind_all() {
  local dir
  for dir in "$SYSFS"/bus/usb/devices/*; do
    [[ -r "$dir/idVendor" ]] || continue
    bound "$dir" && unbind_one "${dir##*/}"
  done
  return 0
}

command=${1:-}
case "$command" in
  list) list_devices ;;
  reconcile) reconcile ;;
  bind) [[ $# == 2 ]] || { usage; exit 64; }; bind_one "$2" ;;
  unbind) [[ $# == 2 ]] || { usage; exit 64; }; unbind_one "$2" ;;
  unbind-all) unbind_all ;;
  start) systemctl start couchliteos-usbipd.service; reconcile ;;
  stop) unbind_all; systemctl stop couchliteos-usbipd.service ;;
  status)
    systemctl --no-pager --full status couchliteos-usbipd.service || true
    echo
    list_devices
    echo
    nft list table inet couchliteos 2>/dev/null || true
    ;;
  *) usage; exit 64 ;;
esac
