#!/bin/bash
set -Eeuo pipefail

action=${1:-apply}
config=${COUCHLITEOS_CONFIG:-/var/lib/couchliteos/config.ini}
lan_ip=
remote=false
peer=

if [[ -r "$config" ]]; then
  readarray -t values < <(python3 - "$config" <<'PY'
import configparser, sys
c=configparser.ConfigParser(); c.read(sys.argv[1])
print(c.get('host:gaming-pc','lan_address',fallback=''))
print(c.get('tailscale','remote_usbip',fallback='false'))
print(c.get('tailscale','allowed_usbip_peer',fallback=''))
PY
)
  [[ -n ${values[0]:-} ]] && lan_ip=${values[0]}
  remote=${values[1]:-false}
  peer=${values[2]:-}
fi

valid_ipv4() {
  python3 - "$1" <<'PY'
import ipaddress, sys
try:
    value = ipaddress.ip_address(sys.argv[1])
except ValueError:
    raise SystemExit(1)
raise SystemExit(0 if value.version == 4 and not value.is_unspecified else 1)
PY
}

valid_tailscale_ipv4() {
  python3 - "$1" <<'PY'
import ipaddress, sys
try:
    value = ipaddress.ip_address(sys.argv[1])
except ValueError:
    raise SystemExit(1)
network = ipaddress.ip_network('100.64.0.0/10')
raise SystemExit(0 if value.version == 4 and value in network else 1)
PY
}

apply_rules() {
  local rules
  rules=$(mktemp)
  trap 'rm -f -- "$rules"' RETURN
  {
    echo 'table inet couchliteos {'
    echo '  chain input {'
    echo '    type filter hook input priority filter; policy accept;'
    echo '    tcp dport 3240 iifname "tailscale0" jump usbip_tailnet'
    echo '    tcp dport 3240 jump usbip_lan'
    echo '  }'
    echo '  chain usbip_lan {'
    echo '    # Physical/LAN policy: one configured Linux gaming host only.'
    if [[ -n "$lan_ip" ]] && valid_ipv4 "$lan_ip"; then
      echo "    ip saddr $lan_ip accept"
    fi
    echo '    drop'
    echo '  }'
    echo '  chain usbip_tailnet {'
    echo '    # Overlay policy is separate and disabled unless explicitly guarded.'
    if [[ "$remote" == true ]] && [[ -n "$peer" ]] && valid_tailscale_ipv4 "$peer"; then
      echo "    ip saddr $peer accept"
    fi
    echo '    drop'
    echo '  }'
    echo '}'
  } > "$rules"
  nft --check --file "$rules"
  nft delete table inet couchliteos 2>/dev/null || true
  nft --file "$rules"
  if [[ -n "$lan_ip" ]] && valid_ipv4 "$lan_ip"; then
    echo "LAN USB/IP TCP/3240 allowed only from $lan_ip"
  else
    echo 'LAN USB/IP TCP/3240 blocked: no literal gaming-host IPv4 configured'
  fi
  if [[ "$remote" == true ]] && [[ -n "$peer" ]] && valid_tailscale_ipv4 "$peer"; then
    echo "Tailscale USB/IP TCP/3240 allowed only from $peer"
    echo 'WARNING: overlay/relay USB/IP can be unreliable for latency-sensitive devices.'
  else
    echo 'Tailscale USB/IP TCP/3240 blocked'
  fi
}

case "$action" in
  apply) apply_rules ;;
  status) nft list table inet couchliteos ;;
  *) echo "Usage: couchliteos-firewall {apply|status}" >&2; exit 64 ;;
esac
