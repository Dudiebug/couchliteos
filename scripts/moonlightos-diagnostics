#!/bin/bash
set -uo pipefail

watch_mode=0
[[ ${1:-} == --watch ]] && watch_mode=1

report() {
  clear 2>/dev/null || true
  echo 'MoonlightOS diagnostics'
  echo "Generated: $(date --iso-8601=seconds)"
  echo
  echo '== OS =='
  cat /etc/os-release 2>/dev/null | grep -E '^(PRETTY_NAME|VERSION_ID)=' || true
  printf 'MoonlightOS: '; cat /etc/moonlightos-version 2>/dev/null || echo unknown
  sed -n 's/^Build profile: /Build profile: /p' /usr/share/moonlightos/build-info 2>/dev/null || true
  printf 'Machine: %s %s\n' "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || echo unknown)" \
    "$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)"
  uname -a
  echo
  echo '== CPU =='
  lscpu 2>/dev/null | grep -E '^(Model name|Architecture|CPU\(s\)|Thread|Core)' || true
  echo
  echo '== GPU / driver =='
  lspci -nnk 2>/dev/null | grep -A3 -Ei 'VGA|Display|3D controller' || true
  lsmod 2>/dev/null | grep -E '^(i915|nouveau|nvidia[a-z_]*|amdgpu|radeon) ' || echo 'no GPU kernel module shown'
  lsmod 2>/dev/null | grep -q '^nvidia' && echo 'WARNING: a proprietary NVIDIA module is loaded'
  echo
  echo '== Vulkan =='
  vulkaninfo --summary 2>&1 | sed -n '1,80p' || true
  echo
  echo '== VA-API decoders =='
  vainfo 2>&1 | grep -E 'VAProfile|Driver version|libva info' || true
  echo
  echo '== Audio =='
  wpctl status 2>&1 | sed -n '1,100p' || true
  aplay -l 2>&1 || true
  echo
  echo '== Sensors =='
  if command -v sensors >/dev/null; then
    sensors 2>&1 | sed -n '1,60p' || true
  else
    echo 'lm-sensors is not installed in this build profile'
  fi
  if [[ -d /sys/devices/platform/applesmc.768 ]]; then
    echo 'applesmc: present'
  elif lsmod 2>/dev/null | grep -q '^applesmc '; then
    echo 'applesmc: module loaded, no SMC device'
  else
    echo 'applesmc: not loaded'
  fi
  echo
  echo '== Bluetooth =='
  /usr/libexec/moonlightos-bluetoothd --snapshot 2>&1 || true
  rfkill list bluetooth 2>&1 || true
  printf 'bluetooth.service: '; systemctl is-active bluetooth.service 2>&1 || true
  printf 'moonlightos-bluetooth.service: '; systemctl is-active moonlightos-bluetooth.service 2>&1 || true
  journalctl -u moonlightos-bluetooth.service --since '-1 hour' --priority=warning \
    --no-pager --output=short-iso 2>&1 | tail -n 40 || true
  echo
  echo '== Network =='
  nmcli device status 2>&1 || true
  for interface in /sys/class/net/*; do
    [[ -e "$interface/device/driver" ]] || continue
    printf '%s driver: %s\n' "${interface##*/}" "$(basename "$(readlink -f "$interface/device/driver")")"
  done
  ip -brief -4 address 2>&1 || true
  ip route 2>&1 || true
  echo
  echo '== USB =='
  lsusb 2>&1 || true
  echo
  echo '== USB/IP =='
  moonlightos-usbip status 2>&1 || true
  echo
  moonlightos-tailscale-diagnostics 2>&1 || true
  echo
  echo '== Display connectors / modes =='
  wlr-randr 2>&1 || true
  echo
  for connector in /sys/class/drm/card*-*/status; do
    [[ -e "$connector" ]] || continue
    base=${connector%/status}
    printf '%s: %s\n' "${base##*/}" "$(cat "$connector")"
    sed 's/^/  /' "$base/modes" 2>/dev/null || true
  done
  echo
  echo '== Applications (sanitized) =='
  /usr/bin/python3 /usr/libexec/moonlightos_apps.py 2>&1 || true
  echo
  echo '== Remote Desktop connections (sanitized) =='
  /usr/bin/python3 /usr/libexec/moonlightos_rdp.py 2>&1 || true
  echo
  echo '== Services =='
  systemctl --no-pager --plain --state=failed 2>&1 || true
}

if ((watch_mode)); then
  while true; do report; echo; echo 'Refresh: 5 seconds. Close with Alt+F4.'; sleep 5; done
else
  report
  if [[ -d /var/log/moonlightos ]]; then
    outfile=/var/log/moonlightos/diagnostics-$(date +%Y%m%d-%H%M%S).txt
    report > "$outfile" 2>&1
    echo "Saved: $outfile"
  fi
fi
