#!/usr/bin/python3 -I
"""Root-only saved Remote Desktop passwords.

Started by couchliteos-rdp-secret.path when the launcher (running as the
appliance user) writes /run/couchliteos/rdp-secret.request:

  set     save a password for one connection, bound to its host, port,
          username, and domain
  delete  remove a saved password
  stage   copy a saved password into the private handoff file that the
          session runner reads, only if the connection still has the settings
          the password was saved for

The unit runs in its own sandbox with no environment from the appliance user.
Passwords are never logged, printed, or passed on a command line.
"""

from __future__ import annotations

import json
import os
import pathlib
import pwd
import sys
import tempfile

sys.path.insert(0, "/usr/libexec")
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "launcher"))
import couchliteos_rdp as rdp  # noqa: E402


def account() -> tuple[int, int]:
    try:
        entry = pwd.getpwnam("couchliteos")
        return entry.pw_uid, entry.pw_gid
    except KeyError:
        return os.getuid(), os.getgid()


def write_status(request_id: str, state: str, message: str, run: pathlib.Path = rdp.RUN) -> None:
    payload = {"request_id": request_id, "state": state, "message": message[:200]}
    descriptor, temporary = tempfile.mkstemp(prefix=".rdp-secret-status.", dir=run)
    try:
        # fchmod, not chmod: the runtime directory belongs to the appliance user.
        os.fchmod(descriptor, 0o644)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, sort_keys=True)
            stream.write("\n")
        os.replace(temporary, run / rdp.SECRET_STATUS.name)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def handle_request(
    run: pathlib.Path = rdp.RUN,
    store: rdp.SecretStore | None = None,
    connections: pathlib.Path = rdp.CONNECTIONS,
    owner: tuple[int, int] | None = None,
) -> int:
    store = store or rdp.SecretStore()
    uid, gid = owner or account()
    request_path = run / rdp.SECRET_REQUEST.name
    request_id = "unknown"
    try:
        try:
            text = rdp.read_owned(request_path, 4096, uid)
        finally:
            request_path.unlink(missing_ok=True)
        if text is None:
            return 0
        payload = rdp.parse_secret_request(text)
        request_id = payload["request_id"]
        connection_id = payload["id"]
        if payload["op"] == "delete":
            store.delete(connection_id)
            message = "saved password removed"
        else:
            connection = rdp.get_connection(connection_id, connections)
            if connection is None:
                raise rdp.RdpError("saved connection does not exist")
            if payload["op"] == "set":
                store.store(connection, payload["password"])
                message = "password saved"
            else:
                password = store.password_for(connection)
                if password is None:
                    raise rdp.RdpError("no password is saved for this connection")
                rdp.stage_handoff(connection_id, password, run, uid, gid)
                message = "password handed to the session"
        write_status(request_id, "success", message, run)
        print(f"Remote Desktop {message} for {connection_id}")
        return 0
    except (OSError, UnicodeError, ValueError) as error:
        detail = str(error) if isinstance(error, rdp.RdpError) else type(error).__name__
        write_status(request_id, "failed", detail, run)
        print(f"Remote Desktop password request failed: {detail}", file=sys.stderr)
        return 1


def main(arguments: list[str]) -> int:
    if arguments == ["request"]:
        return handle_request()
    print("usage: couchliteos-rdp-secret request", file=sys.stderr)
    return 64


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
