#!/bin/bash
set -Eeuo pipefail

pids=()
cleanup() {
  if ((${#pids[@]})); then
    kill "${pids[@]}" 2>/dev/null || true
    wait "${pids[@]}" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

PIPEWIRE_DAEMON=true PIPEWIRE_CORE=pipewire-0 /usr/bin/pipewire & pids+=("$!")
/usr/bin/pipewire-pulse & pids+=("$!")
/usr/bin/wireplumber --profile main-systemwide & pids+=("$!")
wait -n "${pids[@]}"
