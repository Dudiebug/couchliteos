#!/bin/bash
set -Eeuo pipefail

active=/run/moonlightos/osk-active
payload=/run/moonlightos/osk-payload.json
request=/run/moonlightos/start-osk
rm -f -- "$request" "$payload"
touch "$active"
cleanup() { rm -f -- "$active"; }
trap cleanup EXIT INT TERM
/usr/libexec/moonlightos-foot --fullscreen --title 'MOONLIGHTOS KEYBOARD' -- /usr/libexec/moonlightos-osk
rm -f -- "$active"
sleep 0.25
exec /usr/libexec/moonlightos-osk --inject
