#!/bin/bash
set -Eeuo pipefail

output=/run/couchliteos/firefox-drm-status
temporary=$(mktemp /run/couchliteos/.firefox-drm-status.XXXXXX)
trap 'rm -f -- "$temporary"' EXIT
{
  /usr/bin/firefox-esr --version 2>&1 || true
  printf 'Package: '
  dpkg-query -W -f='${binary:Package} ${Version}\n' firefox-esr 2>/dev/null || printf 'unavailable\n'
  printf 'EME policy: '
  if grep -Eq '"EncryptedMediaExtensions"' /etc/firefox/policies/policies.json 2>/dev/null; then
    printf 'enabled\n'
  else
    printf 'not configured\n'
  fi
  printf 'Persistent profile root: '
  [[ -d "$HOME/.mozilla/firefox" && -w "$HOME/.mozilla" ]] && printf 'available\n' || printf 'not initialized\n'
  manifests=()
  while IFS= read -r -d '' manifest; do manifests+=("$manifest"); done < <(
    find "$HOME/.mozilla/firefox" -type f -path '*/gmp-widevinecdm/*/manifest.json' -print0 2>/dev/null
  )
  printf 'Widevine: '
  if ((${#manifests[@]})); then
    versions=()
    for manifest in "${manifests[@]}"; do
      versions+=("$(jq -r '.version // "unknown"' "$manifest" 2>/dev/null || printf unknown)")
    done
    printf 'installed (%s)\n' "$(IFS=,; printf '%s' "${versions[*]}")"
  else
    printf 'not downloaded yet; Firefox installs it on demand\n'
  fi
} > "$temporary"
chmod 0640 "$temporary"
mv -f -- "$temporary" "$output"
trap - EXIT
