#!/bin/bash
set -Eeuo pipefail

flag=/sys/firmware/qemu_fw_cfg/by_name/opt/couchliteos.smoke/raw
[[ -r "$flag" ]] || exit 0
mode=$(tr -d '\0' < "$flag")
# Optional multiplier for slow (for example nested, software-emulated) hosts.
scale=$(tr -d '\0' < /sys/firmware/qemu_fw_cfg/by_name/opt/couchliteos.timeout-scale/raw 2>/dev/null || echo 1)
[[ $scale =~ ^[1-9][0-9]?$ ]] || scale=1
scaled() { echo $(($1 * scale)); }
# Packages the installer added (GRUB, shim), recorded before an update and checked after it.
extras_file=/var/lib/couchliteos-smoke-extras

wait_for_file() {
  local path=$1 label=$2
  for _ in $(seq 1 "$(scaled 450)"); do
    [[ -e "$path" ]] && return 0
    sleep 0.1
  done
  echo "QEMU smoke test timed out waiting for $label" >&2
  exit 1
}

# Remote Desktop state that must survive a reboot: a saved connection, its
# launcher button (label, position, shortcut), and a root-only saved password.
RDP_SMOKE_PASSWORD=qemu-smoke-password-not-secret
rdp_python() {
  runuser -u couchliteos -- env PYTHONDONTWRITEBYTECODE=1 python3 -c "import sys; sys.path.insert(0, '/usr/libexec'); $1"
}
seed_rdp_state() {
  rdp_python "
import couchliteos_apps as apps, couchliteos_rdp as rdp
rdp.upsert_connection(rdp.Connection(id='rdp-qemu', name='QEMU DESKTOP', host='10.0.2.2', username='smoke',
    resolution='1920x1080', save_password=True, certificate='ab' * 32))
apps.write_user_application(apps.Application(id='rdp-qemu', name='QEMU BUTTON', kind='rdp',
    connection='rdp-qemu', status_id='rdp-qemu', order=5, shortcut='lb'))
request = rdp.submit_secret_request('set', 'rdp-qemu', '$RDP_SMOKE_PASSWORD')
ok, message = rdp.wait_secret_status(request, 30 * $scale)
assert ok, message
"
  [[ $(stat -c '%U:%G:%a' /var/lib/couchliteos/rdp-secrets) == root:root:700 ]]
  [[ $(stat -c '%U:%G:%a' /var/lib/couchliteos/rdp-secrets/rdp-qemu) == root:root:600 ]]
  if runuser -u couchliteos -- cat /var/lib/couchliteos/rdp-secrets/rdp-qemu >/dev/null 2>&1; then
    echo 'The appliance user can read a saved Remote Desktop password.' >&2
    exit 1
  fi
  echo COUCHLITEOS_SMOKE_RDP_STATE_WRITTEN
}
verify_rdp_state() {
  rdp_python "
import couchliteos_apps as apps, couchliteos_rdp as rdp
connection = rdp.get_connection('rdp-qemu')
assert connection and connection.host == '10.0.2.2' and connection.save_password, connection
button = next(app for app in apps.load_applications().applications if app.id == 'rdp-qemu')
assert (button.name, button.kind, button.shortcut, button.order) == ('QEMU BUTTON', 'rdp', 'lb', 5), button
"
  # The saved password is still bound to the connection and can be handed to a session.
  rdp_python "
import couchliteos_rdp as rdp
request = rdp.submit_secret_request('stage', 'rdp-qemu')
ok, message = rdp.wait_secret_status(request, 30 * $scale)
assert ok, message
assert rdp.read_handoff() == ('rdp-qemu', '$RDP_SMOKE_PASSWORD')
rdp.HANDOFF.unlink()
"
  echo COUCHLITEOS_SMOKE_RDP_STATE_READY
}
rdp_state_absent() {
  test ! -e /var/lib/couchliteos/rdp-secrets/rdp-qemu
  test ! -e /var/lib/couchliteos/apps.d/rdp-qemu.ini
  ! grep -qs '^\[rdp-qemu\]$' /var/lib/couchliteos/rdp/connections.ini
}

case $mode in
  # Lets tests/qemu-install-smoke.sh stop waiting as soon as an update mode fails.
  update-*|disk-update*|restore-*) trap 'status=$?; [[ $status == 0 ]] || echo COUCHLITEOS_SMOKE_UPDATE_FAILED' EXIT ;;
esac
wait_for_file /run/couchliteos/launcher-ready launcher
# The classic launcher also writes launcher-ready: which front end came up is in the interface
# file (couchliteos-session). Expected `tv` unless the host names another (opt/couchliteos.interface,
# for example `classic` for a forced-classic or Basic Graphics run).
expected=$(tr -d '\0' < /sys/firmware/qemu_fw_cfg/by_name/opt/couchliteos.interface/raw 2>/dev/null || echo tv)
interface=$(sed -n 1p /run/couchliteos/interface 2>/dev/null || true)
why=$(sed -n 2p /run/couchliteos/interface 2>/dev/null || true)
echo "COUCHLITEOS_SMOKE_INTERFACE=${interface:-none} (${why:-no reason recorded})"
if [[ $interface != "$expected" ]]; then
  echo "The launcher came up as ${interface:-none} (${why:-no interface file}), not $expected." >&2
  journalctl -b --no-pager -u couchliteos-launcher.service | tail -n 40 >&2 || true
  exit 1
fi
case $mode in
  persistence-write)
    test -d /sys/firmware/efi
    root_source=$(findmnt -n -o SOURCE /)
    root_fstype=$(findmnt -n -o FSTYPE /)
    root_options=$(findmnt -n -o OPTIONS /)
    [[ $root_source == /dev/vda* ]]
    [[ $root_fstype == ext4 ]]
    [[ ,$root_options, == *,rw,* ]]
    printf 'installed_root=%s fstype=%s options=%s\n' \
      "$root_source" "$root_fstype" "$root_options"
    lsblk --fs
    blkid
    echo COUCHLITEOS_SMOKE_INSTALLED_DISK_READY
    seed_rdp_state
    printf '\n[qemu-smoke]\ncold_boot = verified\n' >> /var/lib/couchliteos/config.ini
    sync
    echo COUCHLITEOS_SMOKE_PERSISTENCE_WRITTEN
    exit 0
    ;;
  persistence-read)
    grep -Fxq 'cold_boot = verified' /var/lib/couchliteos/config.ini
    verify_rdp_state
    echo COUCHLITEOS_SMOKE_PERSISTENCE_READY
    exit 0
    ;;
  update-apply)
    # Boot 1 of the update proof: install the ISO attached as a CD-ROM over this installed system.
    # Whatever the installer added (GRUB, shim) is recorded first; update-check proves it survived.
    dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' 'grub*' 'shim*' 2>/dev/null \
      | awk '$1 == "ii" { print $2 }' > "$extras_file" || true
    if [[ ! -s $extras_file ]]; then
      echo 'No installed grub or shim packages found to record: the update proof would prove nothing.' >&2
      exit 1
    fi
    if ! /usr/libexec/couchliteos-updater apply-iso /dev/sr0 --force --no-reboot; then
      echo 'The update did not apply. Status and log follow.' >&2
      cat /run/couchliteos/update-status.json >&2 || true
      tail -n 80 /var/log/couchliteos/update.log >&2 || true
      exit 1
    fi
    sync
    echo COUCHLITEOS_SMOKE_UPDATE_APPLIED
    exit 0
    ;;
  update-check)
    # Boot 2: the updated system started, kept the owner's state and everything the installer added.
    grep -Fxq 'cold_boot = verified' /var/lib/couchliteos/config.ini
    verify_rdp_state
    grep -q ' done$' /var/log/couchliteos/update.log
    # The update saved the system it replaced: one image, its json and the boot copy.
    test -s /var/lib/couchliteos/snapshot/previous.squashfs
    unsquashfs -s /var/lib/couchliteos/snapshot/previous.squashfs >/dev/null
    python3 -c 'import json, sys; json.load(open(sys.argv[1]))["sha256"]' /var/lib/couchliteos/snapshot/previous.json
    test -s /boot/couchliteos-previous/vmlinuz
    test -s /boot/couchliteos-previous/initrd.img
    grep 'snapshot: saved' /var/log/couchliteos/update.log | tail -n 1
    test -s "$extras_file"
    while read -r package; do
      dpkg -s "$package" | grep -Fxq 'Status: install ok installed' \
        || { echo "Installer package $package is gone after the update." >&2; exit 1; }
    done < "$extras_file"
    [[ -z $(dpkg --audit) ]] || { echo 'dpkg --audit is not clean after the update.' >&2; dpkg --audit >&2; exit 1; }
    id installer-test >/dev/null
    id -nG installer-test | tr ' ' '\n' | grep -Fxq sudo
    echo COUCHLITEOS_SMOKE_UPDATE_READY
    exit 0
    ;;
  restore-apply)
    # After update-check: change something the restore must undo, then ask for the restore the way
    # Settings does. The request service writes root's own request and restarts the box.
    printf '\n[qemu-smoke]\nafter_snapshot = yes\n' >> /var/lib/couchliteos/config.ini
    python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' \
      /var/lib/couchliteos/snapshot/previous.json > /var/lib/couchliteos-smoke-restore-version
    runuser -u couchliteos -- touch /run/couchliteos/restore-request
    wait_for_file /var/lib/couchliteos/snapshot/restore-request 'the restore request'
    sync
    echo COUCHLITEOS_SMOKE_RESTORE_REQUESTED
    exit 0
    ;;
  restore-run)
    # couchliteos-restore.service restores and restarts before the launcher: reaching it means it did not.
    echo 'The launcher started although a restore was requested.' >&2
    tail -n 40 /var/log/couchliteos/update.log >&2 || true
    exit 1
    ;;
  restore-check)
    # The saved version is back: its version, the settings it had, not the change made after it.
    [[ $(cat /etc/couchliteos-version) == "$(cat /var/lib/couchliteos-smoke-restore-version)" ]]
    grep -Fxq 'cold_boot = verified' /var/lib/couchliteos/config.ini
    if grep -Fxq 'after_snapshot = yes' /var/lib/couchliteos/config.ini; then
      echo 'A setting made after the snapshot survived the restore.' >&2
      exit 1
    fi
    grep -q '^paused_until = [0-9]' /var/lib/couchliteos/config.ini
    verify_rdp_state
    grep -q '^.* restore to .* done$' /var/log/couchliteos/update.log
    test ! -e /var/lib/couchliteos/snapshot/restore-request
    test -s /var/lib/couchliteos/snapshot/previous.squashfs
    [[ -z $(dpkg --audit) ]] || { echo 'dpkg --audit is not clean after the restore.' >&2; dpkg --audit >&2; exit 1; }
    id installer-test >/dev/null
    echo COUCHLITEOS_SMOKE_RESTORE_READY
    exit 0
    ;;
  disk-update)
    # tests/qemu-legacy-smoke.sh, boot 1: this ISO, live, with an older install (0.2.0 or
    # MoonlightOS 0.1.13) on the disk. Seed the owner's state in the old layout, then ask for
    # UPDATE THE INSTALLED SYSTEM the way the launcher does and follow the service to the end.
    wait_for_file /run/couchliteos/installs.json 'the search for an installed system'
    device=$(python3 -c 'import json, sys; found = json.load(open(sys.argv[1])); assert len(found) == 1, found; print(found[0]["device"])' \
      /run/couchliteos/installs.json)
    echo "installed system on $device: $(cat /run/couchliteos/installs.json)"
    mkdir -p /run/couchliteos-seed
    mount "$device" /run/couchliteos-seed
    name=couchliteos
    [[ -d /run/couchliteos-seed/var/lib/moonlightos ]] && name=moonlightos  # rename:keep
    data=/run/couchliteos-seed/var/lib/$name
    [[ -e $data/config.ini ]] || install -m 0640 -o 1000 -g "$(stat -c %g "$data")" /dev/null "$data/config.ini"
    printf '\n[qemu-smoke]\nlegacy_update = verified\nold_path = /var/lib/%s/marker\n' "$name" >> "$data/config.ini"
    pairing="$data/home/.config/Moonlight Game Streaming Project/Moonlight.conf"
    [[ -e $pairing ]] || install -D -m 0640 -o 1000 -g "$(stat -c %g "$data")" /dev/null "$pairing"
    printf '[qemu]\nqemu-legacy-pairing=1\n' >> "$pairing"
    install -D -m 0600 /dev/null /run/couchliteos-seed/etc/NetworkManager/system-connections/qemu-legacy.nmconnection
    printf '[connection]\nid=qemu-legacy\ntype=ethernet\n' \
      > /run/couchliteos-seed/etc/NetworkManager/system-connections/qemu-legacy.nmconnection
    sync
    umount /run/couchliteos-seed
    echo COUCHLITEOS_SMOKE_DISK_SEEDED
    rm -f /run/couchliteos/update-status.json
    touch /run/couchliteos/disk-update
    phase=
    for _ in $(seq 1 "$(scaled 2700)"); do
      phase=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("phase", ""))' \
        /run/couchliteos/update-status.json 2>/dev/null || true)
      [[ $phase == updated || $phase == failed ]] && break
      sleep 1
    done
    if [[ $phase != updated ]]; then
      echo 'The installed system was not updated. Status and log follow.' >&2
      cat /run/couchliteos/update-status.json >&2 || true
      journalctl -b --no-pager -u couchliteos-disk-update.service | tail -n 80 >&2 || true
      tail -n 80 /var/log/couchliteos/update.log >&2 || true
      exit 1
    fi
    sync
    echo COUCHLITEOS_SMOKE_DISK_UPDATED
    exit 0
    ;;
  disk-update-check)
    # Boot 2, from the disk: the state is there under the new names, nothing old is left behind,
    # the old system was saved, and SOFTWARE UPDATE can take over from here.
    config=/var/lib/couchliteos/config.ini
    grep -Fxq 'legacy_update = verified' "$config"
    grep -Fxq 'old_path = /var/lib/couchliteos/marker' "$config"
    pairing='/var/lib/couchliteos/home/.config/Moonlight Game Streaming Project/Moonlight.conf'
    grep -Fxq 'qemu-legacy-pairing=1' "$pairing"
    [[ $(stat -c %U "$pairing") == couchliteos ]]
    grep -Fxq 'id=qemu-legacy' /etc/NetworkManager/system-connections/qemu-legacy.nmconnection
    test ! -e /var/lib/moonlightos  # rename:keep
    test ! -e /var/log/moonlightos  # rename:keep
    test ! -e /etc/default/grub.d/20-moonlightos.cfg  # rename:keep
    if getent passwd moonlightos || getent group moonlightos; then  # rename:keep
      echo 'The old account or group is still there.' >&2
      exit 1
    fi
    if find /etc/systemd/system -name 'moonlightos-*' -xtype l | grep .; then  # rename:keep
      echo 'Links to old units that no longer exist were left behind.' >&2
      exit 1
    fi
    grep -q ' done$' /var/log/couchliteos/update.log
    grep 'apply-disk ' /var/log/couchliteos/update.log | tail -n 1
    test -s /var/lib/couchliteos/snapshot/previous.squashfs
    unsquashfs -s /var/lib/couchliteos/snapshot/previous.squashfs >/dev/null
    test -s /boot/couchliteos-previous/vmlinuz
    test -s /etc/grub.d/01_couchliteos_bootcheck
    [[ -z $(dpkg --audit) ]] || { echo 'dpkg --audit is not clean after the update.' >&2; dpkg --audit >&2; exit 1; }
    systemctl is-enabled --quiet couchliteos-update.path
    python3 -c '
import importlib.machinery, importlib.util, sys
sys.path.insert(0, "/usr/libexec")
import couchliteos_update as update
loader = importlib.machinery.SourceFileLoader("couchliteos_updater", "/usr/libexec/couchliteos-updater")
updater = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(updater)
assert update.installed_version(), "no version file"
updater.refuse_live(updater.Env())
updater.refuse_layout(updater.Env())
'
    echo COUCHLITEOS_SMOKE_DISK_UPDATE_READY
    exit 0
    ;;
  live-persistence-write)
    seed_rdp_state
    printf '\n[qemu-smoke]\nlive_persistence = verified\n' >> /var/lib/couchliteos/config.ini
    install -D -m 0640 /dev/null /var/lib/couchliteos/home/.config/moonlight-qemu/state
    install -D -m 0640 /dev/null /var/lib/couchliteos/home/.config/chiaki-qemu/state
    install -D -m 0600 /dev/null /var/lib/tailscale/qemu-state
    install -D -m 0600 /dev/null /var/lib/bluetooth/qemu-state
    install -D -m 0600 /dev/null /etc/NetworkManager/system-connections/qemu-state
    install -D -m 0640 /dev/null /var/log/couchliteos/qemu-state
    sync
    echo COUCHLITEOS_SMOKE_LIVE_PERSISTENCE_WRITTEN
    exit 0
    ;;
  live-persistence-read)
    grep -Fxq 'live_persistence = verified' /var/lib/couchliteos/config.ini
    test -f /var/lib/couchliteos/home/.config/moonlight-qemu/state
    test -f /var/lib/couchliteos/home/.config/chiaki-qemu/state
    test -f /var/lib/tailscale/qemu-state
    test -f /var/lib/bluetooth/qemu-state
    test -f /etc/NetworkManager/system-connections/qemu-state
    [[ $(stat -c '%U:%G:%a' /etc/NetworkManager/system-connections) == root:root:700 ]]
    test -f /var/log/couchliteos/qemu-state
    verify_rdp_state
    echo COUCHLITEOS_SMOKE_LIVE_PERSISTENCE_READY
    exit 0
    ;;
  live-persistence-absent)
    if grep -Fxq 'live_persistence = verified' /var/lib/couchliteos/config.ini; then
      echo 'No Persistence boot still sees the persistent configuration.' >&2
      exit 1
    fi
    test ! -e /var/lib/couchliteos/home/.config/moonlight-qemu/state
    test ! -e /var/lib/couchliteos/home/.config/chiaki-qemu/state
    test ! -e /var/lib/tailscale/qemu-state
    test ! -e /var/lib/bluetooth/qemu-state
    test ! -e /etc/NetworkManager/system-connections/qemu-state
    test ! -e /var/log/couchliteos/qemu-state
    rdp_state_absent
    echo COUCHLITEOS_SMOKE_LIVE_PERSISTENCE_IGNORED
    exit 0
    ;;
  apps) ;;
  *) exit 0 ;;
esac

# Boot-time hardware detection ran before the launcher and wrote its hints.
systemctl is-active --quiet couchliteos-hwdetect-early.service
systemctl is-active --quiet couchliteos-hwdetect.service
if systemctl is-failed --quiet systemd-modules-load.service; then
  systemctl --no-pager --full status systemd-modules-load.service >&2 || true
  echo 'systemd-modules-load failed (a module listed for every boot does not load here).' >&2
  exit 1
fi
test -f /run/modprobe.d/couchliteos-hardware.conf
grep -q '^COUCHLITEOS_GPU_DRIVER=' /run/couchliteos-hardware/hardware.env
grep -q '^COUCHLITEOS_VIDEO_DECODE=' /run/couchliteos-hardware/hardware.env
if grep -qx 'NVIDIA_DRIVER=proprietary' /usr/share/couchliteos/profile.conf; then
  # QEMU has no NVIDIA GPU: the proprietary driver must stay blocked and unloaded.
  grep -qx 'blacklist nvidia-current' /run/modprobe.d/couchliteos-hardware.conf
  if [[ -e /sys/module/nvidia ]]; then
    echo 'The proprietary NVIDIA module loaded on a machine without an NVIDIA GPU.' >&2
    exit 1
  fi
fi
/usr/libexec/couchliteos-hwdetect report
echo COUCHLITEOS_SMOKE_HWDETECT_READY

test -x /usr/libexec/couchliteos-run-configured-app
test -x /usr/libexec/couchliteos-osk
test -x /usr/libexec/couchliteos-osk-session
test -f /usr/share/couchliteos/apps.d/40-terminal.ini
systemctl is-enabled --quiet couchliteos-configured-app.path
systemctl is-enabled --quiet couchliteos-osk.path
test "$(systemctl show --property=NRestarts --value couchliteos-configured-app.service)" = 0
test "$(systemctl show --property=NRestarts --value couchliteos-osk.service)" = 0
echo COUCHLITEOS_SMOKE_CONFIGURED_PLATFORM_READY
for _ in $(seq 1 "$(scaled 250)"); do
  if systemctl is-failed --quiet couchliteos-usbipd.service; then
    systemctl --no-pager --full status couchliteos-usbipd.service >&2 || true
    echo 'USB/IP daemon failed during QEMU smoke test.' >&2
    exit 1
  fi
  if systemctl is-active --quiet couchliteos-usbipd.service; then
    echo COUCHLITEOS_SMOKE_USBIP_READY
    break
  fi
  sleep 0.1
done
systemctl is-active --quiet couchliteos-usbipd.service || {
  systemctl --no-pager --full status couchliteos-usbipd.service >&2 || true
  echo 'USB/IP daemon did not become active during QEMU smoke test.' >&2
  exit 1
}

wait_for_bluetooth_service() {
  for _ in $(seq 1 "$(scaled 100)"); do
    if systemctl is-active --quiet couchliteos-bluetooth.service && \
      /usr/libexec/couchliteos-bluetoothd --snapshot \
        > /tmp/couchliteos-bluetooth-smoke.txt 2>&1; then
      cat /tmp/couchliteos-bluetooth-smoke.txt
      return 0
    fi
    sleep 0.1
  done
  systemctl --no-pager --full status couchliteos-bluetooth.service >&2 || true
  cat /tmp/couchliteos-bluetooth-smoke.txt >&2 || true
  echo 'Bluetooth control service did not become ready without an adapter.' >&2
  return 1
}
wait_for_bluetooth_service
launcher_pid=$(systemctl show --property=MainPID --value couchliteos-launcher.service)
launcher_restarts=$(systemctl show --property=NRestarts --value couchliteos-launcher.service)
audio_pid=$(systemctl show --property=MainPID --value couchliteos-audio.service)
audio_restarts=$(systemctl show --property=NRestarts --value couchliteos-audio.service)
systemctl restart bluetooth.service
systemctl restart couchliteos-bluetooth.service
wait_for_bluetooth_service
test "$launcher_pid" = "$(systemctl show --property=MainPID --value couchliteos-launcher.service)"
test "$launcher_restarts" = "$(systemctl show --property=NRestarts --value couchliteos-launcher.service)"
test "$audio_pid" = "$(systemctl show --property=MainPID --value couchliteos-audio.service)"
test "$audio_restarts" = "$(systemctl show --property=NRestarts --value couchliteos-audio.service)"
runuser -u couchliteos -- env XDG_RUNTIME_DIR=/run/couchliteos \
  PIPEWIRE_RUNTIME_DIR=/run/couchliteos \
  wpctl status > /tmp/couchliteos-audio-smoke.txt 2>&1 || {
  systemctl --no-pager --full status couchliteos-audio.service >&2 || true
  find /run/couchliteos -maxdepth 1 -ls >&2 || true
  find /run -type s -name 'pipewire-*' -ls >&2 || true
  cat /var/log/couchliteos/audio.log >&2 || true
  cat /tmp/couchliteos-audio-smoke.txt >&2 || true
  echo 'PipeWire did not remain ready after Bluetooth service restarts.' >&2
  exit 1
}
echo COUCHLITEOS_SMOKE_BLUETOOTH_READY

systemctl start --no-block couchliteos-moonlight.service
wait_for_file /run/couchliteos/moonlight-ready Moonlight
systemctl stop couchliteos-moonlight.service
systemctl start --no-block couchliteos-chiaki.service
wait_for_file /run/couchliteos/chiaki-ng-ready chiaki-ng
systemctl stop couchliteos-chiaki.service
# Firefox and Google Chrome are not in the image: they install from the internet on demand.
echo COUCHLITEOS_SMOKE_APPS_READY

# Remote Desktop: real password helper, session unit, sdl-freerdp3 under Cage
# without Xwayland, crash-restart policy, and OnFailure cleanup. A local TLS
# endpoint answers the RDP negotiation and closes after the handshake.
systemctl stop couchliteos-configured-app.service || true
test -x /usr/bin/sdl-freerdp3
systemctl is-enabled --quiet couchliteos-rdp.path
systemctl is-enabled --quiet couchliteos-rdp-secret.path
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=couchliteos-smoke \
  -keyout /run/rdp-smoke.key -out /run/rdp-smoke.crt >/dev/null 2>&1
python3 - <<'PY' &
import socket, ssl, struct, threading, time
def hold():
    # Port 33891 accepts and never answers, so a client stays connected.
    quiet = socket.socket()
    quiet.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    quiet.bind(("127.0.0.1", 33891))
    quiet.listen(8)
    held = []
    while True:
        held.append(quiet.accept()[0])
threading.Thread(target=hold, daemon=True).start()
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain("/run/rdp-smoke.crt", "/run/rdp-smoke.key")
listener = socket.socket()
listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
listener.bind(("127.0.0.1", 33890))
listener.listen(8)
while True:
    client, _ = listener.accept()
    try:
        client.settimeout(10)
        client.recv(64)
        client.sendall(b"\x03\x00\x00\x13" + bytes((14, 0xD0, 0, 0, 0, 0, 0)) + struct.pack("<BBHI", 2, 0, 8, 1))
        with context.wrap_socket(client, server_side=True) as tls:
            tls.recv(1)
    except (OSError, ssl.SSLError):
        pass
    finally:
        client.close()
PY
endpoint=$!
for _ in $(seq 1 50); do ss -ltn | grep -q '127.0.0.1:33890 ' && break; sleep 0.1; done
rdp_python "
import couchliteos_rdp as rdp
fingerprint = rdp.probe_certificate('127.0.0.1', 33890)
rdp.upsert_connection(rdp.Connection(id='rdp-smoke', name='SMOKE', host='127.0.0.1', port=33890,
    username='smoke', resolution='fit', certificate=fingerprint))
rdp.write_handoff('rdp-smoke', '$RDP_SMOKE_PASSWORD', rdp.HANDOFF)
rdp.write_session_request('rdp-smoke')
"
client_seen=0
for _ in $(seq 1 "$(scaled 300)"); do
  if pgrep -u couchliteos -f '^/usr/bin/sdl-freerdp3 /v:127.0.0.1 /port:33890 /u:smoke /from-stdin:force' >/dev/null; then
    client_seen=1
    tr '\0' ' ' < "/proc/$(pgrep -u couchliteos -f '^/usr/bin/sdl-freerdp3' | head -1)/cmdline"; echo
    tr '\0' '\n' < "/proc/$(pgrep -u couchliteos -f '^/usr/bin/sdl-freerdp3' | head -1)/environ" | grep -E '^(SDL_VIDEO_DRIVER|WAYLAND_DISPLAY|DISPLAY)=' || true
    break
  fi
  sleep 0.1
done
((client_seen)) || { systemctl --no-pager --full status couchliteos-rdp.service >&2 || true; echo 'RDP client did not start.' >&2; exit 1; }
echo COUCHLITEOS_SMOKE_RDP_CLIENT_STARTED
rdp_session_over() {
  [[ ! -e /run/couchliteos/rdp-session ]] && ! systemctl is-active --quiet couchliteos-rdp.service &&
    ! systemctl is-active --quiet couchliteos-rdp-cleanup.service
}
for _ in $(seq 1 "$(scaled 600)"); do
  rdp_session_over && grep -qs '^failed: ' /run/couchliteos/rdp-smoke-status && break
  sleep 0.1
done
systemctl show --property=NRestarts,Result,ExecMainStatus couchliteos-rdp.service
rdp_session_over
# The OnFailure handler must re-arm the path unit (a start-limit hit stops it).
sleep "$(scaled 2)"
systemctl is-active --quiet couchliteos-rdp.path || {
  systemctl --no-pager --full status couchliteos-rdp.path couchliteos-rdp-cleanup.service >&2 || true
  echo 'Remote Desktop path unit was not re-armed after a failed session.' >&2
  exit 1
}
test ! -e /run/couchliteos/rdp-session.secret
test ! -e /run/couchliteos/rdp.request
grep -q '^failed: ' /run/couchliteos/rdp-smoke-status
cat /run/couchliteos/rdp-smoke-status
if journalctl -b --no-pager | grep -qF "$RDP_SMOKE_PASSWORD" || grep -rqsF "$RDP_SMOKE_PASSWORD" /var/log/couchliteos; then
  echo 'Remote Desktop password leaked into logs.' >&2
  exit 1
fi
test "$launcher_pid" = "$(systemctl show --property=MainPID --value couchliteos-launcher.service)"
# A second launch proves the path unit fires again. Its endpoint never answers,
# so the client stays up; stopping the unit must end it (the client ignores
# SIGTERM, so the runner escalates) without marking the unit failed.
rdp_python "
import couchliteos_rdp as rdp
rdp.upsert_connection(rdp.Connection(id='rdp-hold', name='HOLD', host='127.0.0.1', port=33891,
    username='smoke', certificate='ab' * 32))
rdp.write_handoff('rdp-hold', '$RDP_SMOKE_PASSWORD', rdp.HANDOFF)
rdp.write_session_request('rdp-hold')
"
wait_for_file /run/couchliteos/rdp-hold-ready 'second Remote Desktop session'
pgrep -u couchliteos -f '^/usr/bin/sdl-freerdp3 /v:127.0.0.1 /port:33891' >/dev/null
systemctl stop couchliteos-rdp.service
systemctl show --property=Result,ExecMainStatus couchliteos-rdp.service
if systemctl is-failed --quiet couchliteos-rdp.service; then
  echo 'Stopping a Remote Desktop session marked the unit failed.' >&2
  exit 1
fi
if pgrep -u couchliteos -f '^/usr/bin/sdl-freerdp3' >/dev/null; then
  echo 'The Remote Desktop client outlived its stopped unit.' >&2
  exit 1
fi
test ! -e /run/couchliteos/rdp-session
test ! -e /run/couchliteos/rdp-session.secret
grep -qx 'exited: stopped' /run/couchliteos/rdp-hold-status
kill "$endpoint" 2>/dev/null || true
seed_rdp_state
verify_rdp_state
echo COUCHLITEOS_SMOKE_RDP_READY
