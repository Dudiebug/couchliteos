#!/bin/bash
set -Eeuo pipefail

APP=${1:-}
# The COUCHLITEOS_DEFAULTS, _RUN_DIR, _APPS_DIR and _LIBEXEC_DIR overrides exist so the
# tests can run this script against fake directories; the image never sets them.
# shellcheck source=config/default/couchliteos
source "${COUCHLITEOS_DEFAULTS:-/etc/default/couchliteos}"
RUN_DIR=${COUCHLITEOS_RUN_DIR:-/run/couchliteos}
APPS_DIR=${COUCHLITEOS_APPS_DIR:-/opt/couchliteos/apps}
LIBEXEC_DIR=${COUCHLITEOS_LIBEXEC_DIR:-/usr/libexec}
LOG_DIR=${COUCHLITEOS_LOG_DIR:-/var/log/couchliteos}
DATA_DIR=${COUCHLITEOS_DATA_DIR:-/var/lib/couchliteos}
mkdir -p "$LOG_DIR" "$DATA_DIR/home/.config" "$DATA_DIR/home/.cache"

appdir=
case "$APP" in
  moonlight)
    request=$RUN_DIR/start-moonlight
    appdir=$APPS_DIR/moonlight
    binary=$appdir/usr/bin/moonlight
    ;;
  chiaki-ng)
    request=$RUN_DIR/start-chiaki
    appdir=$APPS_DIR/chiaki-ng
    binary=$appdir/usr/bin/chiaki
    ;;
  firefox)
    request=$RUN_DIR/start-firefox
    binary=/usr/bin/firefox-esr
    ;;
  *)
    echo "Unknown application: $APP" >&2
    exit 64
    ;;
esac

ready=$RUN_DIR/$APP-ready
status_file=$RUN_DIR/$APP-status
active_file=$RUN_DIR/app-active
close_file=$RUN_DIR/close-$APP
rm -f -- "$request" "$ready" "$status_file" "$close_file"

write_status() {
  printf '%s\n' "$1" > "$status_file"
}

# Logs persist across boots, so cap them when an app starts: a log over the
# limit is cut down to its last COUCHLITEOS_LOG_MAX_BYTES (default 5 MiB) and
# kept as the single old copy (.1); the live log then starts empty.
cap_log() {
  local file=$1 max=${COUCHLITEOS_LOG_MAX_BYTES:-5242880} size
  size=$(stat -c %s -- "$file" 2>/dev/null) || return 0
  ((size > max)) || return 0
  if tail -c "$max" -- "$file" > "$file.1.new"; then
    mv -f -- "$file.1.new" "$file.1"
  else
    rm -f -- "$file.1.new"
  fi
  : > "$file"
}

write_status starting
if [[ ! -x "$binary" ]]; then
  write_status "failed: application executable is missing"
  echo "Application executable is missing: $binary" >&2
  exit 66
fi

cap_log "$LOG_DIR/$APP.log"
exec > >(tee -a "$LOG_DIR/$APP.log") 2>&1
if [[ -n "$appdir" ]]; then
  export APPDIR="$appdir"
  export PATH="$appdir/usr/bin:$PATH"
  export LD_LIBRARY_PATH="$appdir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
printf '%s\n' "$APP" > "$active_file"
cleanup() {
  if [[ -f "$active_file" ]] && [[ $(head -n 1 "$active_file" 2>/dev/null || true) == "$APP" ]]; then
    rm -f -- "$active_file"
  fi
  rm -f -- "$ready"
  rm -f -- "$close_file"
}
trap cleanup EXIT INT TERM

READY_REACHED=0
CLOSE_REQUESTED=0
STREAM_REQUESTED=0
run_client() {
  setsid "$@" &
  local pid=$!
  for _ in $(seq 1 50); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid"
      return $?
    fi
    sleep 0.1
  done
  READY_REACHED=1
  touch "$ready"
  write_status started
  echo "COUCHLITEOS_APP_STARTED $APP"
  while kill -0 "$pid" 2>/dev/null; do
    if [[ -e "$close_file" ]]; then
      CLOSE_REQUESTED=1
      rm -f -- "$close_file"
      kill -TERM -- "-$pid" 2>/dev/null || true
      for _ in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
      kill -KILL -- "-$pid" 2>/dev/null || true
      break
    fi
    sleep 0.1
  done
  wait "$pid"
}

printf '%s starting %s\n' "$(date --iso-8601=seconds)" "$APP"
set +e
if [[ "$APP" == firefox ]]; then
  /usr/libexec/couchliteos-firefox-drm-check || true
  run_client "$binary"
  rc=$?
elif [[ "$APP" == moonlight ]]; then
  # The pinned Moonlight Qt payload includes XCB but no Wayland platform
  # plugin, so it runs through Cage's XWayland support.
  host=$(couchliteos-host-address --quiet 2>/dev/null || true)
  # Line 1: profile app. Lines 2-5: validated [moonlight] resolution, fps, codec, decoder.
  mapfile -t moonlight_settings < <(python3 - "$DATA_DIR/config.ini" <<'PY'
import configparser, re, sys
c = configparser.ConfigParser(interpolation=None); c.read(sys.argv[1])
def setting(key, default, pattern):
    value = c.get('moonlight', key, fallback=default).strip()
    return value if re.fullmatch(pattern, value) else default
print(c.get('host:gaming-pc', 'app', fallback='').strip().replace('\n', ' '))
print(setting('resolution', '1920x1080', r'[1-9][0-9]{2,3}x[1-9][0-9]{2,3}'))
print(setting('fps', '60', r'[1-9][0-9]{1,2}'))
print(setting('codec', 'auto', r'auto|H\.264|HEVC|AV1'))
print(setting('decoder', 'auto', r'auto|software|hardware'))
PY
)
  profile_app=${moonlight_settings[0]:-}
  # couchliteos-hwdetect marks GPU drivers without a usable decoder (nouveau).
  # Automatic settings then start with software H.264 instead of failing.
  hardware_env=${COUCHLITEOS_HARDWARE_ENV:-/run/couchliteos-hardware/hardware.env}
  decode_hint=$(sed -n 's/^COUCHLITEOS_VIDEO_DECODE=//p' "$hardware_env" 2>/dev/null | tail -n 1 || true)
  hint_state=auto
  if [[ $decode_hint == software && ${moonlight_settings[3]:-auto} == auto && ${moonlight_settings[4]:-auto} == auto ]]; then
    moonlight_settings[3]=H.264
    moonlight_settings[4]=software
    hint_state=software
    echo "GPU driver $(sed -n 's/^COUCHLITEOS_GPU_DRIVER=//p' "$hardware_env" | tail -n 1) has no usable video decoder; using software H.264"
  fi
  video_options=()
  [[ ${moonlight_settings[3]:-auto} != auto ]] && video_options+=(--video-codec "${moonlight_settings[3]}")
  [[ ${moonlight_settings[4]:-auto} != auto ]] && video_options+=(--video-decoder "${moonlight_settings[4]}")
  # A forced codec or decoder seeds Moonlight's own settings once; later changes
  # in Moonlight persist. The helper also follows the decode hint when this
  # stick moves between PCs: it rewrites only what it wrote itself.
  resolution=${moonlight_settings[1]:-1920x1080}
  /usr/libexec/couchliteos-moonlight-prefs \
    "$DATA_DIR/home/.config/Moonlight Game Streaming Project/Moonlight.conf" \
    "$DATA_DIR/home/.config/couchliteos-decode-seed" "$hint_state" \
    "${resolution%x*}" "${resolution#*x}" "${moonlight_settings[2]:-60}" \
    "${moonlight_settings[3]:-auto}" "${moonlight_settings[4]:-auto}" || true
  if [[ -n "$host" ]]; then
    echo "Selected Sunshine address: $host ($(couchliteos-host-address 2>/dev/null || true))"
  fi
  # Auto-stream: the launcher leaves a host and app name in moonlight-stream.request;
  # the module validates them, so they reach Moonlight as plain arguments (no shell).
  mapfile -t stream_request < <(python3 "$LIBEXEC_DIR"/couchliteos_stream.py take-request "$RUN_DIR/moonlight-stream.request" 2>/dev/null || true)
  if ((${#stream_request[@]} == 2)); then
    host=${stream_request[0]}
    profile_app=${stream_request[1]}
    STREAM_REQUESTED=1
    echo "Auto-stream requested: $host ($profile_app)"
  fi
  if [[ -n "$host" && -n "$profile_app" ]]; then
    run_client env QT_QPA_PLATFORM=xcb "$binary" stream "$host" "$profile_app" "${video_options[@]}"
  else
    run_client env QT_QPA_PLATFORM=xcb "$binary"
  fi
  rc=$?
elif [[ "$APP" == chiaki-ng ]]; then
  gamescope_enabled=${COUCHLITEOS_CHIAKI_GAMESCOPE:-0}
  if [[ -r "$DATA_DIR/config.ini" ]]; then
    configured=$(sed -n 's/^[[:space:]]*gamescope[[:space:]]*=[[:space:]]*//p' "$DATA_DIR/config.ini" | tail -1)
    [[ "$configured" == true ]] && gamescope_enabled=1
  fi
  if [[ "$gamescope_enabled" == 1 ]] && command -v gamescope >/dev/null; then
    run_client gamescope -f -- "$binary"
  else
    run_client env QT_QPA_PLATFORM=wayland SDL_AUDIODRIVER=pipewire "$binary"
  fi
  rc=$?
fi
set -e

if ((CLOSE_REQUESTED == 1)); then
  rc=0
fi

if ((READY_REACHED == 0 && rc != 0)); then
  write_status "failed: exited before the application became ready (status $rc)"
else
  write_status "exited: status $rc"
fi

if ((rc != 0 && STREAM_REQUESTED == 1)); then
  # An auto-stream request is one-shot and already used up. Letting the unit restart
  # (Restart=on-failure) would open the Moonlight GUI, or stream to the profile host,
  # instead of the launcher's error screen with WAKE PC, which reads the status file
  # written above. So a failed request-driven stream exits 0.
  printf '%s %s auto-stream failed with status %d; not restarting, the launcher reports it\n' \
    "$(date --iso-8601=seconds)" "$APP" "$rc" >&2
  exit 0
elif ((rc == 0)); then
  printf '%s %s exited normally; returning to launcher\n' "$(date --iso-8601=seconds)" "$APP"
else
  printf '%s %s crashed/failed with status %d; systemd will retry up to three times\n' \
    "$(date --iso-8601=seconds)" "$APP" "$rc" >&2
fi
exit "$rc"
