#!/bin/bash
set -uo pipefail

config=/var/lib/couchliteos/config.ini
enabled=$(python3 - "$config" <<'PY'
import configparser, sys
c=configparser.ConfigParser(); c.read(sys.argv[1])
print(c.get('tailscale','enabled',fallback='false'))
PY
)

echo '== Tailscale diagnostics =='
if ! command -v tailscale >/dev/null; then
  echo 'State: error (tailscale command is missing)'
  exit 1
fi

json=$(tailscale status --json 2>/dev/null || true)
backend=$(jq -r '.BackendState // "Error"' <<< "$json" 2>/dev/null || echo Error)
case "$backend" in
  Running) state=connected ;;
  NeedsLogin|NoState) state='not logged in' ;;
  Stopped) state=disabled ;;
  *) state=error ;;
esac
[[ "$enabled" == true ]] || [[ "$state" != connected ]] || state='connected (configuration flag was false)'
echo "State: $state"
echo "Tailnet node name: $(jq -r '.Self.HostName // "unavailable"' <<< "$json" 2>/dev/null)"
echo "Tailscale IPv4: $(tailscale ip -4 2>/dev/null || echo unavailable)"
dns_name=$(jq -r '.Self.DNSName // ""' <<< "$json" 2>/dev/null)
echo "MagicDNS name: ${dns_name%.}"
echo
echo '-- tailscale status --'
tailscale status 2>&1 || true
echo

target=$(couchliteos-host-address --tailscale-only --quiet 2>/dev/null || true)
if [[ -n "$target" ]]; then
  echo "-- tailscale ping $target --"
  ping_output=$(tailscale ping --c=5 --timeout=5s "$target" 2>&1 || true)
  printf '%s\n' "$ping_output"
  if grep -q 'peer-relay' <<< "$ping_output"; then
    echo 'Path: peer-relay'
    echo 'WARNING: A peer relay adds latency and may reduce streaming throughput.'
  elif grep -Eq 'via [0-9a-fA-F:.]+:[0-9]+' <<< "$ping_output"; then
    echo 'Path: direct'
  elif grep -q 'via DERP' <<< "$ping_output" || grep -q 'direct connection not established' <<< "$ping_output"; then
    echo 'Path: DERP relay'
    echo 'WARNING: DERP relay latency/throughput may be unsuitable for game streaming.'
  else
    echo 'Path: unknown/offline'
  fi
  latency=$(grep -Eo 'in [0-9.]+ms' <<< "$ping_output" | tail -1 | cut -d' ' -f2)
  echo "Approximate latency: ${latency:-unavailable}"
  if ping -c 1 -W 2 "$target" >/dev/null 2>&1; then
    echo 'Configured Sunshine host: reachable by ICMP'
  else
    echo 'Configured Sunshine host: not reachable by ICMP (stream ports may still differ)'
  fi
else
  echo 'Configured Tailscale Sunshine host: none'
fi

echo
echo '-- tailscale netcheck --'
tailscale netcheck 2>&1 || true
echo
if command -v iperf3 >/dev/null; then
  echo 'Optional iperf3 client is installed; run it manually against an authorized host.'
else
  echo 'Optional iperf3 is not installed (not required at runtime).'
fi
