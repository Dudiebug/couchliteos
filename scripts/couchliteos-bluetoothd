#!/usr/bin/python3
"""Restricted BlueZ control service for the CouchLiteOS launcher."""

from __future__ import annotations

import collections
import json
import os
import pathlib
import re
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
from typing import Any, Callable


BLUEZ = "org.bluez"
OBJECT_MANAGER = "org.freedesktop.DBus.ObjectManager"
PROPERTIES = "org.freedesktop.DBus.Properties"
ADAPTER = "org.bluez.Adapter1"
DEVICE = "org.bluez.Device1"
BATTERY = "org.bluez.Battery1"
AGENT = "org.bluez.Agent1"
AGENT_MANAGER = "org.bluez.AgentManager1"
AGENT_PATH = "/org/couchliteos/BluetoothAgent"
SOCKET_PATH = pathlib.Path("/run/couchliteos-bluetooth/control.sock")
PREFERENCE = pathlib.Path("/var/lib/couchliteos/bluetooth-enabled")
# Written by the audio watcher (couchliteos_audio.py): the audio device used last,
# reconnected once at start-up when it is paired and switched on.
LAST_AUDIO_DEVICE = pathlib.Path("/var/lib/couchliteos/bluetooth-audio-last")
SYSFS_BLUETOOTH = pathlib.Path("/sys/class/bluetooth")
ERROR_SECONDS = 30
MAX_MESSAGE = 8192
MAX_DEVICES = 64
DEVICE_PATH_RE = re.compile(
    r"^/org/bluez/hci\d+/dev_(?:[0-9A-F]{2}_){5}[0-9A-F]{2}$"
)
ADDRESS_RE = re.compile(r"^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$")
AUDIO_UUIDS = {
    "00001108-0000-1000-8000-00805f9b34fb",
    "0000110a-0000-1000-8000-00805f9b34fb",
    "0000110b-0000-1000-8000-00805f9b34fb",
    "0000111e-0000-1000-8000-00805f9b34fb",
}
COMMANDS = {
    "snapshot",
    "set_power",
    "start_scan",
    "stop_scan",
    "pair",
    "cancel_pairing",
    "agent_reply",
    "connect",
    "disconnect",
    "forget",
    "use_audio",
}


def safe_text(value: object, limit: int = 160) -> str:
    return "".join(
        character if character.isprintable() and character not in "\r\n" else "?"
        for character in str(value)
    )[:limit]


def plain(value: object) -> object:
    if isinstance(value, dict):
        return {str(key): plain(item) for key, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [plain(item) for item in value]
    if isinstance(value, (str, int, float, bool)) or value is None:
        return value
    return str(value)


def address_from_path(path: str) -> str:
    match = DEVICE_PATH_RE.fullmatch(path)
    if not match:
        return ""
    return path.rsplit("/dev_", 1)[1].replace("_", ":")


def validate_device_path(value: object) -> str:
    if not isinstance(value, str) or not DEVICE_PATH_RE.fullmatch(value):
        raise ValueError("INVALID BLUETOOTH DEVICE IDENTIFIER")
    return value


def write_preference(enabled: bool, path: pathlib.Path = PREFERENCE) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".bluetooth-enabled.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="ascii") as stream:
            stream.write("1\n" if enabled else "0\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def read_preference(path: pathlib.Path = PREFERENCE) -> bool | None:
    try:
        value = path.read_text(encoding="ascii").strip()
    except (OSError, UnicodeDecodeError):  # a power cut can leave the file corrupt
        return None
    if value == "1":
        return True
    if value == "0":
        return False
    return None


def bluez_error_name(error: object) -> str:
    getter = getattr(error, "get_dbus_name", None)
    return str(getter()) if callable(getter) else ""


BLOCKED_TEXT = "BLUETOOTH IS BLOCKED (RFKILL)"
PAIRING_HINT = (
    "PUT THE CONTROLLER IN PAIRING MODE AND TRY AGAIN. "
    "IF IT WAS PAIRED WITH A CONSOLE, PAIR IT HERE AGAIN."
)
BLUEZ_ERRORS = {
    "Failed": "BLUETOOTH COULD NOT COMPLETE THE REQUEST",
    "AuthenticationFailed": "AUTHENTICATION FAILED",
    "AuthenticationCanceled": "PAIRING WAS CANCELLED",
    "AuthenticationRejected": "THE DEVICE REJECTED PAIRING",
    "AuthenticationTimeout": "THE DEVICE DID NOT ANSWER IN TIME",
    "ConnectionAttemptFailed": "COULD NOT CONNECT TO THE DEVICE",
    "AlreadyExists": "THE DEVICE IS ALREADY PAIRED",
    "AlreadyConnected": "THE DEVICE IS ALREADY CONNECTED",
    "InProgress": "ANOTHER BLUETOOTH ACTION IS IN PROGRESS",
    "NotReady": "BLUETOOTH IS NOT READY YET",
    "Blocked": BLOCKED_TEXT,
    "NotAvailable": "THE DEVICE IS NOT AVAILABLE",
    "NotSupported": "THE DEVICE DOES NOT SUPPORT THIS",
    "DoesNotExist": "THE DEVICE IS NO LONGER KNOWN",
    "NotConnected": "THE DEVICE IS NOT CONNECTED",
    "Rejected": "THE REQUEST WAS REJECTED",
    "NoReply": "THE DEVICE DID NOT ANSWER IN TIME",
}
# Errors that a fresh pairing usually cures.
PAIRING_HINT_ERRORS = {
    "Failed",
    "AuthenticationFailed",
    "AuthenticationRejected",
    "AuthenticationTimeout",
    "ConnectionAttemptFailed",
    "NoReply",
}


def describe_error(error: object, *, hint: bool = False) -> str:
    """Plain-English text for a BlueZ/D-Bus error; unknown errors keep their text."""
    name = bluez_error_name(error).rsplit(".", 1)[-1]
    text = BLUEZ_ERRORS.get(name)
    if text is None:
        return safe_text(error, 120)
    if hint and name in PAIRING_HINT_ERRORS:
        return f"{text}. {PAIRING_HINT}"
    return text


class BluetoothController:
    """Asynchronous BlueZ state and fixed-command dispatcher."""

    def __init__(
        self,
        bus: Any,
        dbus_module: Any,
        glib: Any,
        *,
        preference_path: pathlib.Path = PREFERENCE,
        process_runner: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
        sysfs_bluetooth: pathlib.Path = SYSFS_BLUETOOTH,
        last_audio_path: pathlib.Path = LAST_AUDIO_DEVICE,
    ) -> None:
        self.bus = bus
        self.dbus = dbus_module
        self.glib = glib
        self.preference_path = preference_path
        self.process_runner = process_runner
        self.sysfs_bluetooth = sysfs_bluetooth
        self.last_audio_path = last_audio_path
        self.reconnect_tried = False
        self.objects: dict[str, dict[str, dict[str, object]]] = {}
        self.agent: Any = None
        self.agent_registered = False
        self.bluez_available = False
        self.last_error = ""
        # Set only for one-off failures, which expire; states such as a
        # stopped BlueZ stay until the state changes.
        self.last_error_at: float | None = None
        self.prompt: dict[str, object] | None = None
        self.prompt_callbacks: tuple[Callable[..., None], Callable[[object], None]] | None = None
        self.operation_number = 0
        self.operations: collections.OrderedDict[str, dict[str, object]] = collections.OrderedDict()
        self.active_by_device: dict[str, str] = {}
        self.scan_starting = False
        self.discovery_requested = False

    def start(self, agent_class: type) -> None:
        self.agent = agent_class(self.bus, AGENT_PATH, self)
        self.bus.add_signal_receiver(
            self.interfaces_added,
            signal_name="InterfacesAdded",
            dbus_interface=OBJECT_MANAGER,
            bus_name=BLUEZ,
        )
        self.bus.add_signal_receiver(
            self.interfaces_removed,
            signal_name="InterfacesRemoved",
            dbus_interface=OBJECT_MANAGER,
            bus_name=BLUEZ,
        )
        self.bus.add_signal_receiver(
            self.properties_changed,
            signal_name="PropertiesChanged",
            dbus_interface=PROPERTIES,
            bus_name=BLUEZ,
            path_keyword="path",
        )
        self.bus.watch_name_owner(BLUEZ, self.owner_changed)

    def owner_changed(self, owner: str) -> None:
        # An empty owner while BlueZ was never seen running (the report at
        # startup) means it is not running (Debian starts it only when an
        # adapter exists), not that it restarted.
        was_running = self.bluez_available
        self.bluez_available = bool(owner)
        self.agent_registered = False
        if not owner:
            self.objects.clear()
            self.last_error_at = None
            if not was_running:
                self.last_error = "BLUETOOTH SERVICE IS NOT RUNNING"
                return
            self.last_error = "BLUEZ SERVICE RESTARTING"
            self._reject_prompt("BLUETOOTH SERVICE RESTARTED")
            for operation_id in list(self.active_by_device.values()):
                self._finish(operation_id, "failed", "BLUETOOTH SERVICE RESTARTED")
            return
        self.last_error = ""
        self.last_error_at = None
        self.refresh_objects()
        self.register_agent()

    def refresh_objects(self) -> None:
        try:
            manager = self.dbus.Interface(self.bus.get_object(BLUEZ, "/"), OBJECT_MANAGER)
            manager.GetManagedObjects(
                reply_handler=self._replace_objects,
                error_handler=lambda error: self._record_error("COULD NOT READ BLUEZ STATE", error),
                timeout=2,
            )
        except Exception as error:
            self._record_error("COULD NOT READ BLUEZ STATE", error)

    def _replace_objects(self, objects: object) -> None:
        converted = plain(objects)
        self.objects = converted if isinstance(converted, dict) else {}
        self._clear_error()
        self._apply_saved_power()
        self._reconnect_last_audio()

    def interfaces_added(self, path: object, interfaces: object) -> None:
        path_text = str(path)
        current = self.objects.setdefault(path_text, {})
        converted = plain(interfaces)
        if isinstance(converted, dict):
            current.update(converted)
        if ADAPTER in current:
            self._apply_saved_power()

    def interfaces_removed(self, path: object, interfaces: object) -> None:
        path_text = str(path)
        removed = {str(item) for item in plain(interfaces) or []}
        current = self.objects.get(path_text, {})
        for interface in removed:
            current.pop(interface, None)
        if not current:
            self.objects.pop(path_text, None)
        if ADAPTER in removed:
            self.stop_scan()
            for operation_id in list(self.active_by_device.values()):
                self._finish(operation_id, "failed", "BLUETOOTH ADAPTER REMOVED")
        elif DEVICE in removed:
            operation_id = self.active_by_device.get(path_text)
            if operation_id:
                self._finish(operation_id, "failed", "BLUETOOTH DEVICE REMOVED")

    def properties_changed(
        self,
        interface: object,
        changed: object,
        invalidated: object,
        *,
        path: object,
    ) -> None:
        path_text = str(path)
        interface_text = str(interface)
        properties = self.objects.setdefault(path_text, {}).setdefault(interface_text, {})
        converted = plain(changed)
        if isinstance(converted, dict):
            properties.update(converted)
        for name in plain(invalidated) or []:
            properties.pop(str(name), None)
        if (
            interface_text == ADAPTER
            and self.discovery_requested
            and bool(properties.get("Powered"))
            and not bool(properties.get("Discovering"))
        ):
            self._begin_discovery(path_text)
        if interface_text == ADAPTER and bool(properties.get("Powered")):
            self._reconnect_last_audio()

    def _record_error(self, prefix: str, error: object) -> None:
        if bluez_error_name(error).endswith("Blocked"):
            self.last_error = BLOCKED_TEXT
        else:
            detail = describe_error(error)
            self.last_error = f"{prefix}: {detail}" if detail else prefix
        self.last_error_at = time.monotonic()
        print(self.last_error, file=sys.stderr)

    def _clear_error(self) -> None:
        """A successful BlueZ call ends the last one-off failure."""
        if self.last_error_at is not None:
            self.last_error = ""
            self.last_error_at = None

    def _adapter_hardware_present(self) -> bool:
        try:
            return any(self.sysfs_bluetooth.iterdir())
        except OSError:
            return False

    def current_error(self, adapter_found: bool) -> str:
        if (
            self.last_error_at is not None
            and time.monotonic() - self.last_error_at > ERROR_SECONDS
        ):
            self._clear_error()
        # Without an adapter the launcher shows only that state.
        if not adapter_found and not self._adapter_hardware_present():
            return ""
        return self.last_error

    def adapter(self) -> tuple[str, dict[str, object]] | None:
        adapters = [
            (path, interfaces[ADAPTER])
            for path, interfaces in self.objects.items()
            if ADAPTER in interfaces
        ]
        return sorted(adapters, key=lambda item: item[0])[0] if adapters else None

    def device(self, path: str) -> dict[str, object] | None:
        return self.objects.get(path, {}).get(DEVICE)

    def snapshot(self) -> dict[str, object]:
        adapter = self.adapter()
        adapter_state: dict[str, object] | None = None
        if adapter:
            adapter_state = {
                "path": adapter[0],
                "powered": bool(adapter[1].get("Powered")),
                "discovering": bool(adapter[1].get("Discovering")),
                "address": safe_text(adapter[1].get("Address") or "", 17),
            }
        devices: list[dict[str, object]] = []
        for path, interfaces in sorted(self.objects.items()):
            properties = interfaces.get(DEVICE)
            if not properties or not DEVICE_PATH_RE.fullmatch(path):
                continue
            address = str(properties.get("Address") or address_from_path(path)).upper()
            if not ADDRESS_RE.fullmatch(address):
                continue
            uuids = {str(value).lower() for value in properties.get("UUIDs") or []}
            battery = interfaces.get(BATTERY, {}).get("Percentage")
            try:
                device_class = int(properties.get("Class") or 0)
            except (TypeError, ValueError):
                device_class = 0
            devices.append(
                {
                    "path": path,
                    "address": address,
                    "alias": safe_text(properties.get("Alias") or properties.get("Name") or "", 96),
                    "paired": bool(properties.get("Paired")),
                    "trusted": bool(properties.get("Trusted")),
                    "connected": bool(properties.get("Connected")),
                    "rssi": int(properties.get("RSSI") or -999),
                    "audio": bool(uuids & AUDIO_UUIDS),
                    # The launcher tells headphones, headsets, speakers and controllers apart.
                    "icon": safe_text(properties.get("Icon") or "", 32),
                    "device_class": device_class,
                    "battery": int(battery) if isinstance(battery, int) and 0 <= battery <= 100 else None,
                }
            )
            if len(devices) >= MAX_DEVICES:
                break
        return {
            "ok": True,
            "bluez_available": self.bluez_available,
            "adapter": adapter_state,
            "devices": devices,
            "prompt": dict(self.prompt) if self.prompt else None,
            "operations": [dict(operation) for operation in self.operations.values()],
            "error": self.current_error(adapter is not None),
        }

    def _interface(self, path: str, interface: str) -> Any:
        return self.dbus.Interface(self.bus.get_object(BLUEZ, path), interface)

    def _call(
        self,
        path: str,
        interface: str,
        method: str,
        arguments: tuple[object, ...],
        success: Callable[..., None],
        failure: Callable[[object], None],
        timeout: int,
    ) -> None:
        def succeeded(*values: object) -> None:
            self._clear_error()
            success(*values)

        try:
            function = getattr(self._interface(path, interface), method)
            function(
                *arguments,
                reply_handler=succeeded,
                error_handler=failure,
                timeout=timeout,
            )
        except Exception as error:
            failure(error)

    def _set_property(
        self,
        path: str,
        interface: str,
        name: str,
        value: object,
        success: Callable[..., None],
        failure: Callable[[object], None],
    ) -> None:
        self._call(path, PROPERTIES, "Set", (interface, name, value), success, failure, 3)

    def _apply_saved_power(self) -> None:
        saved = read_preference(self.preference_path)
        adapter = self.adapter()
        if saved is None or not adapter or bool(adapter[1].get("Powered")) == saved:
            return
        self._set_powered(adapter[0], saved, lambda: None, "COULD NOT RESTORE BLUETOOTH POWER")

    def _reconnect_last_audio(self) -> None:
        """Once per start: connect the Bluetooth audio device used last, if it is paired.

        Headphones that are off simply do not answer; the failure is not shown.
        """
        if self.reconnect_tried:
            return
        adapter = self.adapter()
        if not adapter or not bool(adapter[1].get("Powered")):
            return
        try:
            address = self.last_audio_path.read_text(encoding="ascii").strip().upper()
        except (OSError, UnicodeError):
            address = ""
        self.reconnect_tried = True
        if not ADDRESS_RE.fullmatch(address):
            return
        path = f"{adapter[0]}/dev_{address.replace(':', '_')}"
        properties = self.device(path)
        if not properties or not properties.get("Paired") or properties.get("Connected"):
            return
        if path in self.active_by_device:
            return
        self._call(
            path,
            DEVICE,
            "Connect",
            (),
            lambda: None,
            lambda error: print(f"last audio device not reconnected: {describe_error(error)}", file=sys.stderr),
            15,
        )

    def _set_powered(
        self,
        path: str,
        powered: bool,
        success: Callable[[], None],
        prefix: str,
        *,
        retry: bool = True,
    ) -> None:
        """Set Powered; a soft-blocked adapter is unblocked with rfkill and retried once."""

        def failed(error: object) -> None:
            if (
                powered
                and retry
                and bluez_error_name(error).endswith("Blocked")
                and self._unblock_radio()
            ):
                self._set_powered(path, powered, success, prefix, retry=False)
                return
            self._record_error(prefix, error)

        self._set_property(
            path, ADAPTER, "Powered", self.dbus.Boolean(powered), success, failed
        )

    def _unblock_radio(self) -> bool:
        try:
            result = self.process_runner(
                ["rfkill", "unblock", "bluetooth"],
                text=True,
                capture_output=True,
                check=False,
                timeout=3,
            )
        except (OSError, subprocess.SubprocessError):
            return False
        return result.returncode == 0

    def register_agent(self) -> None:
        if not self.agent or not self.bluez_available:
            return
        try:
            manager = self._interface("/org/bluez", AGENT_MANAGER)

            def registered() -> None:
                self.agent_registered = True

            manager.RegisterAgent(
                self.dbus.ObjectPath(AGENT_PATH),
                "KeyboardDisplay",
                reply_handler=registered,
                error_handler=lambda error: self._record_error(
                    "COULD NOT REGISTER BLUETOOTH AGENT", error
                ),
                timeout=3,
            )
        except Exception as error:
            self._record_error("COULD NOT REGISTER BLUETOOTH AGENT", error)

    def _new_operation(self, kind: str, device_path: str) -> dict[str, object]:
        if device_path in self.active_by_device:
            raise ValueError("ANOTHER BLUETOOTH ACTION IS ALREADY RUNNING FOR THIS DEVICE")
        self.operation_number += 1
        operation_id = f"op-{self.operation_number}"
        operation: dict[str, object] = {
            "id": operation_id,
            "type": kind,
            "device": device_path,
            "state": "working",
            "error": "",
            "started": time.monotonic(),
        }
        self.operations[operation_id] = operation
        self.active_by_device[device_path] = operation_id
        while len(self.operations) > 24:
            first_id, first = next(iter(self.operations.items()))
            if first.get("state") == "working":
                break
            self.operations.pop(first_id)
        return operation

    def _finish(self, operation_id: str, state: str, error: str = "") -> None:
        operation = self.operations.get(operation_id)
        if not operation or operation.get("state") != "working":
            return
        operation["state"] = state
        operation["error"] = safe_text(error, 240)
        operation["finished"] = time.monotonic()
        device_path = str(operation.get("device") or "")
        if self.active_by_device.get(device_path) == operation_id:
            self.active_by_device.pop(device_path, None)
        if self.prompt and self.prompt.get("operation_id") == operation_id:
            self._reject_prompt("PAIRING ENDED")

    def _require_adapter(self) -> tuple[str, dict[str, object]]:
        adapter = self.adapter()
        if not adapter:
            raise ValueError("NO BLUETOOTH ADAPTER FOUND")
        return adapter

    def _require_device(self, value: object) -> tuple[str, dict[str, object]]:
        path = validate_device_path(value)
        device = self.device(path)
        if not device:
            raise ValueError("BLUETOOTH DEVICE IS NO LONGER AVAILABLE")
        return path, device

    def set_power(self, powered: bool) -> dict[str, object]:
        path, _properties = self._require_adapter()

        def success() -> None:
            try:
                write_preference(powered, self.preference_path)
            except OSError as error:
                self._record_error("COULD NOT SAVE BLUETOOTH POWER", error)
            if not powered:
                self.stop_scan()

        self._set_powered(path, powered, success, "COULD NOT CHANGE BLUETOOTH POWER")
        return {"ok": True, "accepted": True}

    def _begin_discovery(self, adapter_path: str) -> None:
        adapter = self.adapter()
        if self.scan_starting or (adapter and bool(adapter[1].get("Discovering"))):
            return
        self.scan_starting = True

        def failed(error: object) -> None:
            self.scan_starting = False
            if bluez_error_name(error).endswith("InProgress"):
                return
            self._record_error("BLUETOOTH SCAN FAILED", error)

        def start() -> None:
            self._call(
                adapter_path,
                ADAPTER,
                "StartDiscovery",
                (),
                self._scan_started,
                failed,
                4,
            )

        self._call(
            adapter_path,
            ADAPTER,
            "SetDiscoveryFilter",
            ({"Transport": "auto", "DuplicateData": False},),
            start,
            lambda _error: start(),
            3,
        )

    def _scan_started(self) -> None:
        self.scan_starting = False
        if not self.discovery_requested:
            adapter = self.adapter()
            if adapter:
                self._call(
                    adapter[0], ADAPTER, "StopDiscovery", (), lambda: None,
                    lambda error: self._record_error("COULD NOT STOP BLUETOOTH SCAN", error), 3,
                )

    def start_scan(self) -> dict[str, object]:
        adapter_path, properties = self._require_adapter()
        self.discovery_requested = True
        if bool(properties.get("Powered")) and not bool(properties.get("Discovering")):
            self._begin_discovery(adapter_path)
        elif not bool(properties.get("Powered")):
            self._set_powered(
                adapter_path,
                True,
                lambda: self._begin_discovery(adapter_path),
                "COULD NOT POWER BLUETOOTH FOR SCAN",
            )
        return {"ok": True, "accepted": True}

    def stop_scan(self) -> dict[str, object]:
        self.discovery_requested = False
        self.scan_starting = False
        adapter = self.adapter()
        if adapter and bool(adapter[1].get("Discovering")):
            self._call(
                adapter[0],
                ADAPTER,
                "StopDiscovery",
                (),
                lambda: None,
                lambda error: self._record_error("COULD NOT STOP BLUETOOTH SCAN", error),
                3,
            )
        return {"ok": True, "accepted": True}

    def pair(self, device_value: object) -> dict[str, object]:
        path, properties = self._require_device(device_value)
        operation = self._new_operation("pair", path)
        operation_id = str(operation["id"])
        self.stop_scan()

        def pair_success() -> None:
            self._set_property(
                path,
                DEVICE,
                "Trusted",
                self.dbus.Boolean(True),
                lambda: self._connect_after_pair(operation_id, path),
                lambda error: self._finish(
                    operation_id, "failed", f"PAIRED BUT COULD NOT TRUST DEVICE: {describe_error(error)}"
                ),
            )

        def pair_failure(error: object) -> None:
            name = bluez_error_name(error)
            if name.endswith("AlreadyExists") or bool(properties.get("Paired")):
                pair_success()
            else:
                self._finish(
                    operation_id, "failed", f"PAIRING FAILED: {describe_error(error, hint=True)}"
                )

        if bool(properties.get("Paired")):
            pair_success()
        else:
            self._call(path, DEVICE, "Pair", (), pair_success, pair_failure, 60)
        return {"ok": True, "accepted": True, "operation_id": operation_id}

    def _connect_after_pair(self, operation_id: str, path: str) -> None:
        properties = self.device(path) or {}
        if bool(properties.get("Connected")):
            self._finish(operation_id, "completed")
            return

        def failed(error: object) -> None:
            name = bluez_error_name(error)
            if name.endswith("AlreadyConnected"):
                self._finish(operation_id, "completed")
            else:
                self._finish(
                    operation_id,
                    "paired",
                    "DEVICE IS PAIRED, BUT CONNECTION FAILED. TRY CONNECT AGAIN.",
                )

        self._call(
            path,
            DEVICE,
            "Connect",
            (),
            lambda: self._finish(operation_id, "completed"),
            failed,
            15,
        )

    def cancel_pairing(self, operation_value: object = "") -> dict[str, object]:
        operation_id = str(operation_value or "")
        operation = self.operations.get(operation_id)
        if not operation or operation.get("type") != "pair" or operation.get("state") != "working":
            raise ValueError("NO MATCHING PAIRING OPERATION")
        path = str(operation["device"])
        self._reject_prompt("PAIRING CANCELLED")
        self._call(path, DEVICE, "CancelPairing", (), lambda: None, lambda _error: None, 3)
        self._finish(operation_id, "cancelled", "PAIRING CANCELLED")
        return {"ok": True, "accepted": True}

    def _device_action(self, kind: str, device_value: object) -> dict[str, object]:
        path, properties = self._require_device(device_value)
        operation = self._new_operation(kind, path)
        operation_id = str(operation["id"])
        method = "Connect" if kind == "connect" else "Disconnect"
        already = bool(properties.get("Connected")) == (kind == "connect")
        if already:
            self._finish(operation_id, "completed")
        else:
            self._call(
                path,
                DEVICE,
                method,
                (),
                lambda: self._finish(operation_id, "completed"),
                lambda error: self._finish(
                    operation_id,
                    "failed",
                    f"{kind.upper()} FAILED: {describe_error(error, hint=kind == 'connect')}",
                ),
                15,
            )
        return {"ok": True, "accepted": True, "operation_id": operation_id}

    def forget(self, device_value: object) -> dict[str, object]:
        path, _properties = self._require_device(device_value)
        adapter_path = path.rsplit("/", 1)[0]
        operation = self._new_operation("forget", path)
        operation_id = str(operation["id"])
        self._call(
            adapter_path,
            ADAPTER,
            "RemoveDevice",
            (self.dbus.ObjectPath(path),),
            lambda: self._finish(operation_id, "completed"),
            lambda error: self._finish(
                operation_id, "failed", f"FORGET DEVICE FAILED: {describe_error(error)}"
            ),
            10,
        )
        return {"ok": True, "accepted": True, "operation_id": operation_id}

    def use_audio(self, device_value: object) -> dict[str, object]:
        path, properties = self._require_device(device_value)
        uuids = {str(value).lower() for value in properties.get("UUIDs") or []}
        if not uuids & AUDIO_UUIDS:
            raise ValueError("THIS DEVICE DOES NOT ADVERTISE A BLUETOOTH AUDIO PROFILE")
        if not bool(properties.get("Connected")):
            raise ValueError("CONNECT THE BLUETOOTH AUDIO DEVICE FIRST")
        operation = self._new_operation("use_audio", path)
        operation_id = str(operation["id"])
        alias = safe_text(properties.get("Alias") or properties.get("Name") or "", 96)
        address = str(properties.get("Address") or address_from_path(path)).upper()

        def worker() -> None:
            error = self._select_audio_sink(alias, address)
            self.glib.idle_add(
                lambda: self._finish(operation_id, "failed", error)
                if error
                else self._finish(operation_id, "completed")
            )

        threading.Thread(target=worker, name="bluetooth-audio-select", daemon=True).start()
        return {"ok": True, "accepted": True, "operation_id": operation_id}

    def _select_audio_sink(self, alias: str, address: str) -> str:
        try:
            status = self.process_runner(
                ["wpctl", "status", "-n"],
                text=True,
                capture_output=True,
                check=False,
                timeout=3,
            )
        except (OSError, subprocess.SubprocessError):
            return "BLUETOOTH AUDIO DEVICE CONNECTED BUT NO AUDIO OUTPUT APPEARED"
        if status.returncode:
            return "BLUETOOTH AUDIO DEVICE CONNECTED BUT NO AUDIO OUTPUT APPEARED"
        needles = {alias.casefold(), address.casefold(), address.replace(":", "_").casefold()}
        needles.discard("")
        in_sinks = False
        sink_id = ""
        for line in status.stdout.splitlines():
            if "Sinks:" in line:
                in_sinks = True
                continue
            if in_sinks and re.search(r"\bSources:\s*$", line):
                break
            if not in_sinks or not any(needle in line.casefold() for needle in needles):
                continue
            match = re.search(r"(?:^|\s)(\d+)\.\s", line)
            if match:
                sink_id = match.group(1)
                break
        if not sink_id:
            return "BLUETOOTH AUDIO DEVICE CONNECTED BUT NO AUDIO OUTPUT APPEARED"
        try:
            changed = self.process_runner(
                ["wpctl", "set-default", sink_id],
                text=True,
                capture_output=True,
                check=False,
                timeout=3,
            )
        except (OSError, subprocess.SubprocessError):
            return "BLUETOOTH AUDIO OUTPUT COULD NOT BE SELECTED"
        return "" if changed.returncode == 0 else "BLUETOOTH AUDIO OUTPUT COULD NOT BE SELECTED"

    def set_prompt(
        self,
        kind: str,
        device_path: str,
        reply: Callable[..., None] | None,
        reject: Callable[[object], None] | None,
        *,
        passkey: object = "",
        service: str = "",
    ) -> None:
        if self.prompt_callbacks:
            self._reject_prompt("ANOTHER PAIRING PROMPT REPLACED THIS REQUEST")
        properties = self.device(device_path) or {}
        operation_id = self.active_by_device.get(device_path, "")
        prompt_id = f"prompt-{time.monotonic_ns()}"
        self.prompt = {
            "id": prompt_id,
            "kind": kind,
            "device": device_path,
            "device_alias": safe_text(properties.get("Alias") or properties.get("Name") or "", 96),
            "passkey": safe_text(passkey, 16),
            "service": safe_text(service, 64),
            "operation_id": operation_id,
        }
        self.prompt_callbacks = (reply, reject) if reply and reject else None

    def _dbus_rejection(self, message: str) -> object:
        error = self.dbus.DBusException(safe_text(message, 120))
        error._dbus_error_name = "org.bluez.Error.Rejected"
        return error

    def _reject_prompt(self, message: str) -> None:
        callbacks = self.prompt_callbacks
        self.prompt = None
        self.prompt_callbacks = None
        if callbacks:
            try:
                callbacks[1](self._dbus_rejection(message))
            except Exception:
                pass

    def agent_reply(self, request: dict[str, object]) -> dict[str, object]:
        if not self.prompt or str(request.get("prompt_id") or "") != self.prompt.get("id"):
            raise ValueError("PAIRING PROMPT EXPIRED")
        callbacks = self.prompt_callbacks
        if not callbacks:
            self.prompt = None
            return {"ok": True, "accepted": True}
        if request.get("accepted") is not True:
            self._reject_prompt("PAIRING REJECTED")
            return {"ok": True, "accepted": True}
        kind = str(self.prompt.get("kind") or "")
        value = request.get("value")
        if kind == "pin_code":
            if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9]{1,16}", value):
                raise ValueError("PIN MUST CONTAIN 1 TO 16 LETTERS OR DIGITS")
        elif kind == "passkey":
            if not isinstance(value, int) or not 0 <= value <= 999999:
                raise ValueError("PASSKEY MUST BE A NUMBER FROM 0 TO 999999")
            value = self.dbus.UInt32(value)
        self.prompt = None
        self.prompt_callbacks = None
        if kind in {"pin_code", "passkey"}:
            callbacks[0](value)
        else:
            callbacks[0]()
        return {"ok": True, "accepted": True}

    def handle(self, request: object) -> dict[str, object]:
        if not isinstance(request, dict):
            raise ValueError("REQUEST MUST BE A JSON OBJECT")
        command = request.get("command")
        if not isinstance(command, str) or command not in COMMANDS:
            raise ValueError("UNSUPPORTED BLUETOOTH COMMAND")
        if command == "snapshot":
            return self.snapshot()
        if command == "set_power":
            if not isinstance(request.get("powered"), bool):
                raise ValueError("POWERED MUST BE TRUE OR FALSE")
            return self.set_power(bool(request["powered"]))
        if command == "start_scan":
            return self.start_scan()
        if command == "stop_scan":
            return self.stop_scan()
        if command == "pair":
            return self.pair(request.get("device"))
        if command == "cancel_pairing":
            return self.cancel_pairing(request.get("operation_id"))
        if command == "agent_reply":
            return self.agent_reply(request)
        if command in {"connect", "disconnect"}:
            return self._device_action(command, request.get("device"))
        if command == "forget":
            return self.forget(request.get("device"))
        if command == "use_audio":
            return self.use_audio(request.get("device"))
        raise ValueError("UNSUPPORTED BLUETOOTH COMMAND")

    def shutdown(self) -> None:
        self.stop_scan()
        self._reject_prompt("BLUETOOTH SERVICE STOPPING")
        if self.agent_registered:
            try:
                self._interface("/org/bluez", AGENT_MANAGER).UnregisterAgent(
                    self.dbus.ObjectPath(AGENT_PATH), timeout=2
                )
            except Exception:
                pass


class JsonSocketServer:
    def __init__(self, path: pathlib.Path, controller: BluetoothController, glib: Any) -> None:
        self.path = path
        self.controller = controller
        self.glib = glib
        self.listener: socket.socket | None = None
        self.listener_watch: int | None = None
        self.clients: dict[int, tuple[socket.socket, bytearray, int]] = {}

    def start(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        try:
            mode = self.path.lstat().st_mode
            if not stat.S_ISSOCK(mode):
                raise RuntimeError("REFUSING TO REPLACE NON-SOCKET CONTROL PATH")
            self.path.unlink()
        except FileNotFoundError:
            pass
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(str(self.path))
        os.chmod(self.path, 0o600)
        listener.listen(8)
        listener.setblocking(False)
        self.listener = listener
        self.listener_watch = self.glib.io_add_watch(
            listener.fileno(), self.glib.IO_IN, self._accept
        )

    def _accept(self, _fd: int, _condition: int) -> bool:
        if not self.listener:
            return False
        while True:
            try:
                client, _address = self.listener.accept()
            except BlockingIOError:
                break
            client.setblocking(False)
            fd = client.fileno()
            watch = self.glib.io_add_watch(
                fd,
                self.glib.IO_IN | self.glib.IO_HUP | self.glib.IO_ERR,
                self._read_client,
            )
            self.clients[fd] = (client, bytearray(), watch)
        return True

    def _close_client(self, fd: int) -> None:
        client_state = self.clients.pop(fd, None)
        if not client_state:
            return
        client, _buffer, watch = client_state
        try:
            self.glib.source_remove(watch)
        except Exception:
            pass
        client.close()

    def _send(self, fd: int, response: dict[str, object]) -> None:
        state = self.clients.get(fd)
        if not state:
            return
        client = state[0]
        encoded = (json.dumps(response, separators=(",", ":"), sort_keys=True) + "\n").encode()
        try:
            client.setblocking(True)
            client.settimeout(0.25)
            client.sendall(encoded)
        except OSError:
            pass
        self._close_client(fd)

    def _read_client(self, fd: int, condition: int) -> bool:
        state = self.clients.get(fd)
        if not state:
            return False
        client, buffer, _watch = state
        if condition & (self.glib.IO_HUP | self.glib.IO_ERR) and not (condition & self.glib.IO_IN):
            self._close_client(fd)
            return False
        try:
            chunk = client.recv(4096)
        except BlockingIOError:
            return True
        except OSError:
            self._close_client(fd)
            return False
        if not chunk:
            self._close_client(fd)
            return False
        buffer.extend(chunk)
        if len(buffer) > MAX_MESSAGE:
            self._send(fd, {"ok": False, "error": "BLUETOOTH REQUEST IS TOO LARGE"})
            return False
        if b"\n" not in buffer:
            return True
        line, trailing = bytes(buffer).split(b"\n", 1)
        if trailing.strip():
            self._send(fd, {"ok": False, "error": "ONLY ONE REQUEST IS ALLOWED"})
            return False
        try:
            request = json.loads(line.decode("utf-8"))
            response = self.controller.handle(request)
        except (UnicodeDecodeError, json.JSONDecodeError):
            response = {"ok": False, "error": "INVALID JSON REQUEST"}
        except (ValueError, RuntimeError) as error:
            response = {"ok": False, "error": safe_text(error, 240)}
        except Exception as error:
            print(f"BLUETOOTH REQUEST FAILED: {safe_text(error)}", file=sys.stderr)
            response = {"ok": False, "error": "BLUETOOTH REQUEST FAILED"}
        self._send(fd, response)
        return False

    def close(self) -> None:
        for fd in list(self.clients):
            self._close_client(fd)
        if self.listener_watch is not None:
            try:
                self.glib.source_remove(self.listener_watch)
            except Exception:
                pass
        if self.listener:
            self.listener.close()
        try:
            if stat.S_ISSOCK(self.path.lstat().st_mode):
                self.path.unlink()
        except FileNotFoundError:
            pass


def build_agent_class(dbus_module: Any) -> type:
    class PairingAgent(dbus_module.service.Object):
        def __init__(self, bus: Any, path: str, controller: BluetoothController) -> None:
            super().__init__(bus, path)
            self.controller = controller

        @dbus_module.service.method(AGENT, in_signature="", out_signature="")
        def Release(self) -> None:
            self.controller._reject_prompt("BLUETOOTH AGENT RELEASED")

        @dbus_module.service.method(
            AGENT, in_signature="o", out_signature="s", async_callbacks=("reply", "reject")
        )
        def RequestPinCode(self, device: object, reply: Callable[..., None], reject: Callable[[object], None]) -> None:
            self.controller.set_prompt("pin_code", str(device), reply, reject)

        @dbus_module.service.method(
            AGENT, in_signature="o", out_signature="u", async_callbacks=("reply", "reject")
        )
        def RequestPasskey(self, device: object, reply: Callable[..., None], reject: Callable[[object], None]) -> None:
            self.controller.set_prompt("passkey", str(device), reply, reject)

        @dbus_module.service.method(AGENT, in_signature="os", out_signature="")
        def DisplayPinCode(self, device: object, pin_code: object) -> None:
            self.controller.set_prompt("display_passkey", str(device), None, None, passkey=pin_code)

        @dbus_module.service.method(AGENT, in_signature="ouq", out_signature="")
        def DisplayPasskey(self, device: object, passkey: object, _entered: object) -> None:
            self.controller.set_prompt("display_passkey", str(device), None, None, passkey=f"{int(passkey):06d}")

        @dbus_module.service.method(
            AGENT, in_signature="ou", out_signature="", async_callbacks=("reply", "reject")
        )
        def RequestConfirmation(
            self,
            device: object,
            passkey: object,
            reply: Callable[..., None],
            reject: Callable[[object], None],
        ) -> None:
            self.controller.set_prompt(
                "confirmation", str(device), reply, reject, passkey=f"{int(passkey):06d}"
            )

        @dbus_module.service.method(
            AGENT, in_signature="o", out_signature="", async_callbacks=("reply", "reject")
        )
        def RequestAuthorization(
            self, device: object, reply: Callable[..., None], reject: Callable[[object], None]
        ) -> None:
            self.controller.set_prompt("authorization", str(device), reply, reject)

        @dbus_module.service.method(
            AGENT, in_signature="os", out_signature="", async_callbacks=("reply", "reject")
        )
        def AuthorizeService(
            self,
            device: object,
            service: object,
            reply: Callable[..., None],
            reject: Callable[[object], None],
        ) -> None:
            self.controller.set_prompt(
                "authorization", str(device), reply, reject, service=str(service)
            )

        @dbus_module.service.method(AGENT, in_signature="", out_signature="")
        def Cancel(self) -> None:
            self.controller._reject_prompt("PAIRING CANCELLED BY BLUEZ")

    return PairingAgent


def print_snapshot(path: pathlib.Path = SOCKET_PATH) -> int:
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(1)
    try:
        client.connect(str(path))
        client.sendall(b'{"command":"snapshot"}\n')
        data = b""
        while b"\n" not in data and len(data) <= 65536:
            chunk = client.recv(4096)
            if not chunk:
                break
            data += chunk
    except OSError as error:
        print(f"Bluetooth service unavailable: {safe_text(error)}")
        return 1
    finally:
        client.close()
    try:
        response = json.loads(data.split(b"\n", 1)[0])
    except (UnicodeDecodeError, json.JSONDecodeError):
        print("Bluetooth service returned invalid data")
        return 1
    adapter = response.get("adapter") if isinstance(response, dict) else None
    if not isinstance(adapter, dict):
        print("Adapter: not found")
    else:
        print(f"Adapter: {safe_text(adapter.get('address') or 'unknown', 17)}")
        print(f"Powered: {'yes' if adapter.get('powered') else 'no'}")
        print(f"Discovering: {'yes' if adapter.get('discovering') else 'no'}")
    print("Known devices:")
    for device in response.get("devices", []) if isinstance(response, dict) else []:
        print(
            f"- {safe_text(device.get('alias') or 'Unknown device', 96)}: "
            f"paired={'yes' if device.get('paired') else 'no'} "
            f"connected={'yes' if device.get('connected') else 'no'}"
        )
    return 0


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--snapshot":
        return print_snapshot()
    try:
        import dbus
        import dbus.service
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib
    except ImportError as error:
        print(f"Bluetooth runtime dependency missing: {safe_text(error)}", file=sys.stderr)
        return 1

    DBusGMainLoop(set_as_default=True)
    loop = GLib.MainLoop()
    controller = BluetoothController(dbus.SystemBus(), dbus, GLib)
    server = JsonSocketServer(SOCKET_PATH, controller, GLib)
    try:
        controller.start(build_agent_class(dbus))
        server.start()
    except Exception as error:
        print(f"Bluetooth service startup failed: {safe_text(error)}", file=sys.stderr)
        return 1

    def stop() -> bool:
        loop.quit()
        return False

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    try:
        loop.run()
    finally:
        controller.shutdown()
        server.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
