#!/usr/bin/python3 -I
"""CouchLiteOS boot-time hardware detection.

early   Before udev and systemd-modules-load: write this machine's kernel
        module policy under /run only, so a USB stick moved to another machine
        starts clean on every boot.
late    Before the launcher: load the nouveau fallback if the proprietary
        NVIDIA driver cannot drive this GPU or did not load, then write GPU
        driver and video decode hints for the launcher and applications.
        With Secure Boot on, the unsigned NVIDIA and Broadcom wl DKMS modules
        are never used: nouveau and the open Wi-Fi drivers take over.
report  Print the last detection summary.
"""

import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

SYSFS = Path(os.environ.get("COUCHLITEOS_SYSFS_ROOT", "/sys"))
CMDLINE = Path(os.environ.get("COUCHLITEOS_PROC_CMDLINE", "/proc/cmdline"))
RUN = Path(os.environ.get("COUCHLITEOS_RUN_ROOT", "/run"))
MODULE_DIR = Path(os.environ.get("COUCHLITEOS_MODULE_DIR", f"/lib/modules/{os.uname().release}"))
NVIDIA_IDS = Path(os.environ.get("COUCHLITEOS_NVIDIA_IDS", "/usr/share/nvidia/nvidia.ids"))
BROADCOM_IDS = Path(os.environ.get("COUCHLITEOS_BROADCOM_STA_IDS", "/usr/share/broadcom-sta/broadcom-sta.ids"))
MODPROBE = os.environ.get("COUCHLITEOS_MODPROBE", "/usr/sbin/modprobe")
FIRMWARE_HELPER = os.environ.get("COUCHLITEOS_FIRMWARE_HELPER", "/usr/libexec/couchliteos-nvidia-firmware")
UDEVADM = os.environ.get("COUCHLITEOS_UDEVADM", "/usr/bin/udevadm")

STATE_DIR = RUN / "couchliteos-hardware"
MODPROBE_CONF = RUN / "modprobe.d" / "couchliteos-hardware.conf"
MODULES_LOAD_CONF = RUN / "modules-load.d" / "couchliteos-hardware.conf"

NVIDIA = 0x10DE
BROADCOM = 0x14E4
# Debian's nvidia-kernel-dkms installs the modules as nvidia-current*; the
# plain names are the aliases and install commands in nvidia-modprobe.conf.
NVIDIA_MODULES = [
    f"{name}{part}"
    for name in ("nvidia", "nvidia-current")
    for part in ("", "-drm", "-modeset", "-uvm", "-peermem")
]
# The open drivers that broadcom-sta-dkms blacklists when wl owns the chip.
BROADCOM_OPEN_MODULES = ["b43", "b43legacy", "b44", "bcma", "brcm80211", "brcmsmac", "ssb"]
APPLE_VENDORS = {"Apple Inc.", "Apple Computer, Inc."}
SECURE_BOOT_VARIABLE = "SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"
# Debian builds the DRM module as nvidia-current-drm; upstream names it nvidia-drm.
NVIDIA_DRM_MODULES = ["nvidia_drm", "nvidia_current_drm"]


def read(path):
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def pci_devices():
    base = SYSFS / "bus" / "pci" / "devices"
    devices = []
    try:
        entries = sorted(base.iterdir())
    except OSError:
        return devices
    for entry in entries:
        try:
            vendor = int(read(entry / "vendor"), 16)
            device = int(read(entry / "device"), 16)
            pci_class = int(read(entry / "class"), 16)
        except ValueError:
            continue
        driver = ""
        try:
            driver = os.path.basename(os.readlink(entry / "driver"))
        except OSError:
            pass
        devices.append({
            "slot": entry.name,
            "id": f"{vendor:04x}:{device:04x}",
            "vendor": vendor,
            "device": device,
            "class": pci_class,
            "driver": driver,
            "boot_vga": read(entry / "boot_vga") == "1",
        })
    return devices


def is_display(device):
    return device["class"] >> 16 == 0x03


def is_wireless(device):
    return device["class"] >> 8 == 0x0280


def id_list(path):
    """Read vendor+device IDs written as eight hex digits, one per line."""
    ids = set()
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ids
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"([0-9A-Fa-f]{4})([0-9A-Fa-f]{4})", line.split()[0])
        if match:
            ids.add((int(match.group(1), 16), int(match.group(2), 16)))
    return ids


def kernel_options():
    options = {}
    for token in read(CMDLINE).split():
        key, _, value = token.partition("=")
        if key.startswith("couchliteos."):
            options[key] = value
    return options


def secure_boot_enabled():
    """True when firmware Secure Boot is on: the kernel then refuses unsigned modules.

    The efivar holds 4 attribute bytes, then one data byte (1 = enabled). A
    missing or short file (legacy BIOS, Apple EFI, no efivarfs) counts as off.
    """
    try:
        data = (SYSFS / "firmware" / "efi" / "efivars" / SECURE_BOOT_VARIABLE).read_bytes()
    except OSError:
        return False
    return len(data) >= 5 and data[4] == 1


def dkms_module_present(name):
    return any((MODULE_DIR / "updates" / "dkms").glob(f"{name}.ko*"))


def primary_display(devices):
    displays = [device for device in devices if is_display(device)]
    for device in displays:
        if device["boot_vga"]:
            return device
    return displays[0] if displays else None


def detect(devices):
    """Decide the module policy for this machine from PCI and DMI identifiers."""
    options = kernel_options()
    basic = options.get("couchliteos.gpu") == "basic"
    # DKMS modules (nvidia, wl) are unsigned: with Secure Boot on they never load.
    secure = secure_boot_enabled()
    displays = [device for device in devices if is_display(device)]
    nvidia_gpus = [device for device in displays if device["vendor"] == NVIDIA]
    blacklist, load, notes = [], [], []

    proprietary_installed = NVIDIA_IDS.is_file() and dkms_module_present("nvidia-current")
    nvidia_mode = "none"
    if nvidia_gpus:
        nvidia_mode = "nouveau"
    if proprietary_installed:
        supported_ids = id_list(NVIDIA_IDS)
        supported = [gpu for gpu in nvidia_gpus if (gpu["vendor"], gpu["device"]) in supported_ids]
        if supported and not basic and not secure:
            nvidia_mode = "proprietary"
            load.append("nvidia-drm")
            blacklist.append("nouveau")
            notes.append("NVIDIA: proprietary driver for " + ", ".join(gpu["id"] for gpu in supported))
        else:
            blacklist.extend(NVIDIA_MODULES)
            if basic:
                reason = "Basic Graphics (couchliteos.gpu=basic) requested"
            elif supported and secure:
                reason = "Secure Boot is on and the kernel refuses the unsigned NVIDIA driver"
            elif nvidia_gpus:
                reason = "not supported by the installed NVIDIA driver: " + ", ".join(gpu["id"] for gpu in nvidia_gpus)
            else:
                reason = "no NVIDIA GPU"
            notes.append(f"NVIDIA: proprietary driver blocked ({reason})")
            if nvidia_gpus:
                notes.append("NVIDIA: nouveau loads as the fallback")
    elif nvidia_gpus:
        notes.append("NVIDIA: nouveau (open driver)")

    broadcom = "none"
    broadcom_wifi = [device for device in devices if device["vendor"] == BROADCOM and is_wireless(device)]
    if dkms_module_present("wl") and BROADCOM_IDS.is_file():
        sta_ids = id_list(BROADCOM_IDS)
        wl_devices = [device for device in broadcom_wifi if (device["vendor"], device["device"]) in sta_ids]
        if wl_devices and not secure:
            broadcom = "wl"
            blacklist.extend(BROADCOM_OPEN_MODULES)
            notes.append("Broadcom Wi-Fi: wl for " + ", ".join(device["id"] for device in wl_devices))
        else:
            broadcom = "open"
            blacklist.append("wl")
            if wl_devices:
                notes.append(
                    "Broadcom Wi-Fi: Secure Boot is on and the kernel refuses the unsigned wl driver for "
                    + ", ".join(device["id"] for device in wl_devices)
                    + "; the open drivers are used and may not support this chip")
            elif broadcom_wifi:
                notes.append("Broadcom Wi-Fi: open driver for " + ", ".join(device["id"] for device in broadcom_wifi))

    apple = read(SYSFS / "class" / "dmi" / "id" / "sys_vendor") in APPLE_VENDORS
    if apple:
        load.append("applesmc")
        notes.append("Apple hardware: applesmc sensors")

    return {
        "basic_graphics": basic,
        "secure_boot": secure,
        "nvidia_driver_installed": proprietary_installed,
        "nvidia_mode": nvidia_mode,
        "nouveau_fallback": proprietary_installed and nvidia_mode == "nouveau",
        "broadcom": broadcom,
        "apple": apple,
        "blacklist": blacklist,
        "load": load,
        "notes": notes,
    }


def write_file(path, text, mode=0o644):
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def devices_summary(devices):
    lines = []
    for device in devices:
        if is_display(device) or (is_wireless(device) and device["vendor"] == BROADCOM):
            kind = "GPU" if is_display(device) else "Wi-Fi"
            boot = " (boot display)" if device["boot_vga"] else ""
            lines.append(f"{kind} {device['slot']} [{device['id']}] driver={device['driver'] or 'none'}{boot}")
    return lines or ["No GPU found on the PCI bus"]


def early():
    devices = pci_devices()
    state = detect(devices)
    header = "# Written at boot by couchliteos-hwdetect for this machine; not persistent.\n"
    write_file(MODPROBE_CONF, header + "".join(f"blacklist {name}\n" for name in state["blacklist"]))
    write_file(MODULES_LOAD_CONF, header + "".join(f"{name}\n" for name in state["load"]))
    STATE_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    write_file(STATE_DIR / "state.json", json.dumps(state, indent=2) + "\n")
    for line in devices_summary(devices) + state["notes"]:
        print(line)
    return 0


def run(command):
    try:
        result = subprocess.run(command, check=False, stdin=subprocess.DEVNULL, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f"{command[0]}: {error}", file=sys.stderr)
        return 1
    return result.returncode


def late():
    try:
        state = json.loads((STATE_DIR / "state.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        print("couchliteos-hwdetect early did not run; deciding now", file=sys.stderr)
        state = detect(pci_devices())
    status = 0
    # Let udev finish binding the drivers it loads before reading the result.
    run([UDEVADM, "settle", "--timeout=10"])
    notes = list(state.get("notes", []))
    reason = ""
    if state.get("nouveau_fallback"):
        reason = "the proprietary NVIDIA driver cannot drive this GPU"
    elif state.get("nvidia_mode") == "proprietary" and not any(
            (SYSFS / "module" / name).exists() for name in NVIDIA_DRM_MODULES):
        # The kernel refused the module (or it failed to load): without it there is
        # no KMS for Cage. nouveau is the same fallback Kepler and Basic Graphics use.
        reason = "the proprietary NVIDIA driver did not load (nvidia_drm is missing)"
        notes.append("NVIDIA: " + reason + "; nouveau loads as the fallback")
    if reason and not (SYSFS / "module" / "nouveau").exists():
        # The NVIDIA ISO blacklists nouveau for udev; loading it by name still works.
        print(f"Loading nouveau: {reason}")
        if run([MODPROBE, "nouveau"]) != 0:
            print("modprobe nouveau failed; the display falls back to the firmware framebuffer", file=sys.stderr)
            status = 1
        run([UDEVADM, "settle", "--timeout=15"])

    devices = pci_devices()
    primary = primary_display(devices)
    driver = primary["driver"] if primary and primary["driver"] else "none"
    decode = "auto"
    if driver == "nouveau":
        # Kepler and older have no usable decoder on nouveau (the H.264 decoder
        # needs non-redistributable firmware); newer chips have none at all.
        decode = "software"
        # Unless the user fetched NVIDIA's firmware (Settings > STREAMING) and
        # it was seen decoding on this GPU: the helper also points the kernel at it.
        if Path(FIRMWARE_HELPER).exists() and run([FIRMWARE_HELPER, "--boot", primary["id"] if primary else "none"]) == 0:
            decode = "auto"
            notes.append("Video decoder firmware: NVIDIA's, fetched on this PC and verified on this GPU")
    environment = {
        "COUCHLITEOS_GPU_DRIVER": driver,
        "COUCHLITEOS_GPU_ID": primary["id"] if primary else "none",
        "COUCHLITEOS_VIDEO_DECODE": decode,
    }
    write_file(STATE_DIR / "hardware.env", "".join(f"{key}={value}\n" for key, value in environment.items()))
    compositor = ""
    if driver.startswith("nvidia"):
        # wlroots hardware cursors are unreliable on the proprietary driver.
        compositor += "WLR_NO_HARDWARE_CURSORS=1\n"
    write_file(STATE_DIR / "compositor.env", compositor)

    blacklist = state.get("blacklist", [])
    lines = [
        f"CouchLiteOS hardware detection ({datetime.datetime.now().astimezone().isoformat(timespec='seconds')})",
        *devices_summary(devices),
        *notes,
        f"Display driver: {driver}",
        f"Moonlight video decode: {'software H.264' if decode == 'software' else 'automatic'}",
        f"Blacklisted for this boot: {' '.join(blacklist) if blacklist else 'none'}",
        f"Loaded at boot: {' '.join(state.get('load', [])) or 'none'}",
    ]
    write_file(STATE_DIR / "summary.txt", "\n".join(lines) + "\n")
    print("\n".join(lines))
    return status


def report():
    summary = read(STATE_DIR / "summary.txt")
    if summary:
        print(summary)
        return 0
    print("Hardware detection has not run on this boot.")
    for line in devices_summary(pci_devices()):
        print(line)
    return 1


def main(argv):
    commands = {"early": early, "late": late, "report": report}
    if len(argv) != 2 or argv[1] not in commands:
        print("usage: couchliteos-hwdetect early|late|report", file=sys.stderr)
        return 64
    return commands[argv[1]]()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
