#!/usr/bin/python3
"""HDMI-CEC TV control daemon. Runs as root, and only when a /dev/cec* device exists.

It registers the kernel CEC adapter as a Playback device called CouchLiteOS,
switches the TV on (if the setting is on), then follows the bus and suspends
the PC when the TV reports Standby (if that setting is on). With no CEC
hardware, or no link to a TV, it does nothing.

`couchliteos-cec --standby` is the pre-sleep hook: it sends Standby to the TV (if that setting is on
and the TV is showing this box: the daemon keeps /run/couchliteos/cec-active-source for that) and
exits within about two seconds.
"""

from __future__ import annotations

import pathlib
import subprocess
import sys
import time

sys.path.insert(0, "/usr/libexec")
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "launcher"))
import couchliteos_cec as cec  # noqa: E402

SYSTEMCTL = "/usr/bin/systemctl"
RETRY_SECONDS = 30  # adapter present but no link to a TV yet (TV off at the wall, cable out)
RETRY_MAX_SECONDS = 300  # each look that fails waits twice as long, up to this
RESTART_SECONDS = 5  # the monitor ended (adapter reset); look again


def log(message: str) -> None:
    print(f"couchliteos-cec: {message}", flush=True)


def suspend() -> None:
    try:
        subprocess.run([SYSTEMCTL, "suspend"], check=False, timeout=30)
    except (OSError, subprocess.SubprocessError) as error:
        log(f"suspend failed: {error}")


def settings() -> cec.Settings:
    return cec.effective_settings(cec.load_settings(), cec.suspend_supported())


def follow(adapter: cec.Adapter, last_tv_on: float) -> None:
    """Read the bus until the monitor ends (adapter unplugged or reset)."""
    monitor = subprocess.Popen(
        cec.cec_ctl(adapter.device, "--skip-info", "--monitor"),
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace",
    )
    try:
        cec.watch(
            monitor.stdout, settings, time.monotonic, suspend, log, last_tv_on,
            phys_addr=adapter.phys_addr, marker=cec.ACTIVE_SOURCE_MARKER,
        )
    finally:
        monitor.terminate()
        monitor.wait()


def standby_before_sleep() -> int:
    """Run by couchliteos-cec-sleep.service just before the PC sleeps; quick, and never fails the sleep."""
    devices = cec.device_nodes()
    if not devices:
        return 0
    settings = cec.load_settings()
    if cec.should_standby_on_sleep(settings, cec.ACTIVE_SOURCE_MARKER):
        ok = cec.standby_tv(devices)
        log("TV sent to standby before sleep" if ok else "TV did not answer Standby before sleep")
    elif settings.tv_off_on_sleep:
        log("TV left alone before sleep: it is not known to be showing this box")
    return 0


def main(argv: tuple[str, ...] | list[str] = ()) -> int:
    if list(argv) == ["--standby"]:
        return standby_before_sleep()
    started = None
    delay = 0  # how long to wait before looking for a TV link again; 0 while there is one
    while True:
        devices = cec.device_nodes()
        if not devices:
            log("no CEC device; nothing to do")
            return 0
        adapter = cec.bring_up(devices=devices, edid=cec.edid_path())
        if adapter is None:
            if not delay:  # say it when it starts, not on every look
                log("no CEC adapter that can reach a TV yet; waiting")
            delay = min(delay * 2, RETRY_MAX_SECONDS) if delay else RETRY_SECONDS
            time.sleep(delay)
            continue
        if delay:
            log("CEC link to a TV found")
            delay = 0
        if started is None:
            log(f"{adapter.device} ({adapter.driver}) physical address {adapter.phys_addr}")
            # What the TV shows is not known until we say (Active Source below) or hear it.
            cec.mark_active_source(False, cec.ACTIVE_SOURCE_MARKER, log)
            if cec.load_settings().turn_tv_on:
                ok = cec.turn_tv_on(adapter.device, adapter.phys_addr, log=log)
                log("TV switched on" if ok else "TV did not answer Image View On")
                if ok:  # it ends by making this box the active source
                    cec.mark_active_source(True, cec.ACTIVE_SOURCE_MARKER, log)
            started = time.monotonic()  # a standby soon after this is our own doing, not the user's
        follow(adapter, started)
        time.sleep(RESTART_SECONDS)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
