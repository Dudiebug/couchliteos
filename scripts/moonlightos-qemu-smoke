#!/bin/bash
set -Eeuo pipefail

flag=/sys/firmware/qemu_fw_cfg/by_name/opt/moonlightos.smoke/raw
[[ -r "$flag" ]] || exit 0
mode=$(tr -d '\0' < "$flag")
# Optional multiplier for slow (for example nested, software-emulated) hosts.
scale=$(tr -d '\0' < /sys/firmware/qemu_fw_cfg/by_name/opt/moonlightos.timeout-scale/raw 2>/dev/null || echo 1)
[[ $scale =~ ^[1-9][0-9]?$ ]] || scale=1
scaled() { echo $(($1 * scale)); }

wait_for_file() {
  local path=$1 label=$2
  for _ in $(seq 1 "$(scaled 450)"); do
    [[ -e "$path" ]] && return 0
    sleep 0.1
  done
  echo "QEMU smoke test timed out waiting for $label" >&2
  exit 1
}

# Remote Desktop state that must survive a reboot: a saved connection, its
# launcher button (label, position, shortcut), and a root-only saved password.
RDP_SMOKE_PASSWORD=qemu-smoke-password-not-secret
rdp_python() {
  runuser -u moonlightos -- env PYTHONDONTWRITEBYTECODE=1 python3 -c "import sys; sys.path.insert(0, '/usr/libexec'); $1"
}
seed_rdp_state() {
  rdp_python "
import moonlightos_apps as apps, moonlightos_rdp as rdp
rdp.upsert_connection(rdp.Connection(id='rdp-qemu', name='QEMU DESKTOP', host='10.0.2.2', username='smoke',
    resolution='1920x1080', save_password=True, certificate='ab' * 32))
apps.write_user_application(apps.Application(id='rdp-qemu', name='QEMU BUTTON', kind='rdp',
    connection='rdp-qemu', status_id='rdp-qemu', order=5, shortcut='lb'))
request = rdp.submit_secret_request('set', 'rdp-qemu', '$RDP_SMOKE_PASSWORD')
ok, message = rdp.wait_secret_status(request, 30 * $scale)
assert ok, message
"
  [[ $(stat -c '%U:%G:%a' /var/lib/moonlightos/rdp-secrets) == root:root:700 ]]
  [[ $(stat -c '%U:%G:%a' /var/lib/moonlightos/rdp-secrets/rdp-qemu) == root:root:600 ]]
  ! runuser -u moonlightos -- cat /var/lib/moonlightos/rdp-secrets/rdp-qemu >/dev/null 2>&1
  echo MOONLIGHTOS_SMOKE_RDP_STATE_WRITTEN
}
verify_rdp_state() {
  rdp_python "
import moonlightos_apps as apps, moonlightos_rdp as rdp
connection = rdp.get_connection('rdp-qemu')
assert connection and connection.host == '10.0.2.2' and connection.save_password, connection
button = next(app for app in apps.load_applications().applications if app.id == 'rdp-qemu')
assert (button.name, button.kind, button.shortcut, button.order) == ('QEMU BUTTON', 'rdp', 'lb', 5), button
"
  # The saved password is still bound to the connection and can be handed to a session.
  rdp_python "
import moonlightos_rdp as rdp
request = rdp.submit_secret_request('stage', 'rdp-qemu')
ok, message = rdp.wait_secret_status(request, 30 * $scale)
assert ok, message
assert rdp.read_handoff() == ('rdp-qemu', '$RDP_SMOKE_PASSWORD')
rdp.HANDOFF.unlink()
"
  echo MOONLIGHTOS_SMOKE_RDP_STATE_READY
}
rdp_state_absent() {
  test ! -e /var/lib/moonlightos/rdp-secrets/rdp-qemu
  test ! -e /var/lib/moonlightos/apps.d/rdp-qemu.ini
  ! grep -qs '^\[rdp-qemu\]$' /var/lib/moonlightos/rdp/connections.ini
}

wait_for_file /run/moonlightos/launcher-ready launcher
case $mode in
  persistence-write)
    test -d /sys/firmware/efi
    root_source=$(findmnt -n -o SOURCE /)
    root_fstype=$(findmnt -n -o FSTYPE /)
    root_options=$(findmnt -n -o OPTIONS /)
    [[ $root_source == /dev/vda* ]]
    [[ $root_fstype == ext4 ]]
    [[ ,$root_options, == *,rw,* ]]
    printf 'installed_root=%s fstype=%s options=%s\n' \
      "$root_source" "$root_fstype" "$root_options"
    lsblk --fs
    blkid
    echo MOONLIGHTOS_SMOKE_INSTALLED_DISK_READY
    seed_rdp_state
    printf '\n[qemu-smoke]\ncold_boot = verified\n' >> /var/lib/moonlightos/config.ini
    sync
    echo MOONLIGHTOS_SMOKE_PERSISTENCE_WRITTEN
    exit 0
    ;;
  persistence-read)
    grep -Fxq 'cold_boot = verified' /var/lib/moonlightos/config.ini
    verify_rdp_state
    echo MOONLIGHTOS_SMOKE_PERSISTENCE_READY
    exit 0
    ;;
  live-persistence-write)
    seed_rdp_state
    printf '\n[qemu-smoke]\nlive_persistence = verified\n' >> /var/lib/moonlightos/config.ini
    install -D -m 0640 /dev/null /var/lib/moonlightos/home/.config/moonlight-qemu/state
    install -D -m 0640 /dev/null /var/lib/moonlightos/home/.config/chiaki-qemu/state
    install -D -m 0600 /dev/null /var/lib/tailscale/qemu-state
    install -D -m 0600 /dev/null /var/lib/bluetooth/qemu-state
    install -D -m 0640 /dev/null /var/log/moonlightos/qemu-state
    sync
    echo MOONLIGHTOS_SMOKE_LIVE_PERSISTENCE_WRITTEN
    exit 0
    ;;
  live-persistence-read)
    grep -Fxq 'live_persistence = verified' /var/lib/moonlightos/config.ini
    test -f /var/lib/moonlightos/home/.config/moonlight-qemu/state
    test -f /var/lib/moonlightos/home/.config/chiaki-qemu/state
    test -f /var/lib/tailscale/qemu-state
    test -f /var/lib/bluetooth/qemu-state
    test -f /var/log/moonlightos/qemu-state
    verify_rdp_state
    echo MOONLIGHTOS_SMOKE_LIVE_PERSISTENCE_READY
    exit 0
    ;;
  live-persistence-absent)
    ! grep -Fxq 'live_persistence = verified' /var/lib/moonlightos/config.ini
    test ! -e /var/lib/moonlightos/home/.config/moonlight-qemu/state
    test ! -e /var/lib/moonlightos/home/.config/chiaki-qemu/state
    test ! -e /var/lib/tailscale/qemu-state
    test ! -e /var/lib/bluetooth/qemu-state
    test ! -e /var/log/moonlightos/qemu-state
    rdp_state_absent
    echo MOONLIGHTOS_SMOKE_LIVE_PERSISTENCE_IGNORED
    exit 0
    ;;
  apps) ;;
  *) exit 0 ;;
esac

test -x /usr/libexec/moonlightos-run-configured-app
test -x /usr/libexec/moonlightos-osk
test -x /usr/libexec/moonlightos-osk-session
test -f /usr/share/moonlightos/apps.d/40-terminal.ini
systemctl is-enabled --quiet moonlightos-configured-app.path
systemctl is-enabled --quiet moonlightos-osk.path
test "$(systemctl show --property=NRestarts --value moonlightos-configured-app.service)" = 0
test "$(systemctl show --property=NRestarts --value moonlightos-osk.service)" = 0
echo MOONLIGHTOS_SMOKE_CONFIGURED_PLATFORM_READY
for _ in $(seq 1 "$(scaled 250)"); do
  if systemctl is-failed --quiet moonlightos-usbipd.service; then
    systemctl --no-pager --full status moonlightos-usbipd.service >&2 || true
    echo 'USB/IP daemon failed during QEMU smoke test.' >&2
    exit 1
  fi
  if systemctl is-active --quiet moonlightos-usbipd.service; then
    echo MOONLIGHTOS_SMOKE_USBIP_READY
    break
  fi
  sleep 0.1
done
systemctl is-active --quiet moonlightos-usbipd.service || {
  systemctl --no-pager --full status moonlightos-usbipd.service >&2 || true
  echo 'USB/IP daemon did not become active during QEMU smoke test.' >&2
  exit 1
}

wait_for_bluetooth_service() {
  for _ in $(seq 1 "$(scaled 100)"); do
    if systemctl is-active --quiet moonlightos-bluetooth.service && \
      /usr/libexec/moonlightos-bluetoothd --snapshot \
        > /tmp/moonlightos-bluetooth-smoke.txt 2>&1; then
      cat /tmp/moonlightos-bluetooth-smoke.txt
      return 0
    fi
    sleep 0.1
  done
  systemctl --no-pager --full status moonlightos-bluetooth.service >&2 || true
  cat /tmp/moonlightos-bluetooth-smoke.txt >&2 || true
  echo 'Bluetooth control service did not become ready without an adapter.' >&2
  return 1
}
wait_for_bluetooth_service
launcher_pid=$(systemctl show --property=MainPID --value moonlightos-launcher.service)
launcher_restarts=$(systemctl show --property=NRestarts --value moonlightos-launcher.service)
audio_pid=$(systemctl show --property=MainPID --value moonlightos-audio.service)
audio_restarts=$(systemctl show --property=NRestarts --value moonlightos-audio.service)
systemctl restart bluetooth.service
systemctl restart moonlightos-bluetooth.service
wait_for_bluetooth_service
test "$launcher_pid" = "$(systemctl show --property=MainPID --value moonlightos-launcher.service)"
test "$launcher_restarts" = "$(systemctl show --property=NRestarts --value moonlightos-launcher.service)"
test "$audio_pid" = "$(systemctl show --property=MainPID --value moonlightos-audio.service)"
test "$audio_restarts" = "$(systemctl show --property=NRestarts --value moonlightos-audio.service)"
runuser -u moonlightos -- env XDG_RUNTIME_DIR=/run/moonlightos \
  PIPEWIRE_RUNTIME_DIR=/run/moonlightos \
  wpctl status > /tmp/moonlightos-audio-smoke.txt 2>&1 || {
  systemctl --no-pager --full status moonlightos-audio.service >&2 || true
  find /run/moonlightos -maxdepth 1 -ls >&2 || true
  find /run -type s -name 'pipewire-*' -ls >&2 || true
  cat /var/log/moonlightos/audio.log >&2 || true
  cat /tmp/moonlightos-audio-smoke.txt >&2 || true
  echo 'PipeWire did not remain ready after Bluetooth service restarts.' >&2
  exit 1
}
echo MOONLIGHTOS_SMOKE_BLUETOOTH_READY

systemctl start --no-block moonlightos-moonlight.service
wait_for_file /run/moonlightos/moonlight-ready Moonlight
systemctl stop moonlightos-moonlight.service
systemctl start --no-block moonlightos-chiaki.service
wait_for_file /run/moonlightos/chiaki-ng-ready chiaki-ng
systemctl stop moonlightos-chiaki.service
systemctl start --no-block moonlightos-firefox.service
wait_for_file /run/moonlightos/firefox-ready Firefox
printf 'google-chrome\n' > /run/moonlightos/launch-app.request
systemctl start --no-block moonlightos-configured-app.service
wait_for_file /run/moonlightos/google-chrome-ready 'Google Chrome'
echo MOONLIGHTOS_SMOKE_APPS_READY

# Remote Desktop: real password helper, session unit, sdl-freerdp3 under Cage
# without Xwayland, crash-restart policy, and OnFailure cleanup. A local TLS
# endpoint answers the RDP negotiation and closes after the handshake.
systemctl stop moonlightos-firefox.service moonlightos-configured-app.service || true
test -x /usr/bin/sdl-freerdp3
systemctl is-enabled --quiet moonlightos-rdp.path
systemctl is-enabled --quiet moonlightos-rdp-secret.path
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=moonlightos-smoke \
  -keyout /run/rdp-smoke.key -out /run/rdp-smoke.crt >/dev/null 2>&1
python3 - <<'PY' &
import socket, ssl, struct, threading, time
def hold():
    # Port 33891 accepts and never answers, so a client stays connected.
    quiet = socket.socket()
    quiet.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    quiet.bind(("127.0.0.1", 33891))
    quiet.listen(8)
    held = []
    while True:
        held.append(quiet.accept()[0])
threading.Thread(target=hold, daemon=True).start()
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain("/run/rdp-smoke.crt", "/run/rdp-smoke.key")
listener = socket.socket()
listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
listener.bind(("127.0.0.1", 33890))
listener.listen(8)
while True:
    client, _ = listener.accept()
    try:
        client.settimeout(10)
        client.recv(64)
        client.sendall(b"\x03\x00\x00\x13" + bytes((14, 0xD0, 0, 0, 0, 0, 0)) + struct.pack("<BBHI", 2, 0, 8, 1))
        with context.wrap_socket(client, server_side=True) as tls:
            tls.recv(1)
    except (OSError, ssl.SSLError):
        pass
    finally:
        client.close()
PY
endpoint=$!
for _ in $(seq 1 50); do ss -ltn | grep -q '127.0.0.1:33890 ' && break; sleep 0.1; done
rdp_python "
import moonlightos_rdp as rdp
fingerprint = rdp.probe_certificate('127.0.0.1', 33890)
rdp.upsert_connection(rdp.Connection(id='rdp-smoke', name='SMOKE', host='127.0.0.1', port=33890,
    username='smoke', resolution='fit', certificate=fingerprint))
rdp.write_handoff('rdp-smoke', '$RDP_SMOKE_PASSWORD', rdp.HANDOFF)
rdp.write_session_request('rdp-smoke')
"
client_seen=0
for _ in $(seq 1 "$(scaled 300)"); do
  if pgrep -u moonlightos -f '^/usr/bin/sdl-freerdp3 /v:127.0.0.1 /port:33890 /u:smoke /from-stdin:force' >/dev/null; then
    client_seen=1
    tr '\0' ' ' < "/proc/$(pgrep -u moonlightos -f '^/usr/bin/sdl-freerdp3' | head -1)/cmdline"; echo
    tr '\0' '\n' < "/proc/$(pgrep -u moonlightos -f '^/usr/bin/sdl-freerdp3' | head -1)/environ" | grep -E '^(SDL_VIDEO_DRIVER|WAYLAND_DISPLAY|DISPLAY)=' || true
    break
  fi
  sleep 0.1
done
((client_seen)) || { systemctl --no-pager --full status moonlightos-rdp.service >&2 || true; echo 'RDP client did not start.' >&2; exit 1; }
echo MOONLIGHTOS_SMOKE_RDP_CLIENT_STARTED
rdp_session_over() {
  [[ ! -e /run/moonlightos/rdp-session ]] && ! systemctl is-active --quiet moonlightos-rdp.service &&
    ! systemctl is-active --quiet moonlightos-rdp-cleanup.service
}
for _ in $(seq 1 "$(scaled 600)"); do
  rdp_session_over && grep -qs '^failed: ' /run/moonlightos/rdp-smoke-status && break
  sleep 0.1
done
systemctl show --property=NRestarts,Result,ExecMainStatus moonlightos-rdp.service
rdp_session_over
# The OnFailure handler must re-arm the path unit (a start-limit hit stops it).
sleep "$(scaled 2)"
systemctl is-active --quiet moonlightos-rdp.path || {
  systemctl --no-pager --full status moonlightos-rdp.path moonlightos-rdp-cleanup.service >&2 || true
  echo 'Remote Desktop path unit was not re-armed after a failed session.' >&2
  exit 1
}
test ! -e /run/moonlightos/rdp-session.secret
test ! -e /run/moonlightos/rdp.request
grep -q '^failed: ' /run/moonlightos/rdp-smoke-status
cat /run/moonlightos/rdp-smoke-status
if journalctl -b --no-pager | grep -qF "$RDP_SMOKE_PASSWORD" || grep -rqsF "$RDP_SMOKE_PASSWORD" /var/log/moonlightos; then
  echo 'Remote Desktop password leaked into logs.' >&2
  exit 1
fi
test "$launcher_pid" = "$(systemctl show --property=MainPID --value moonlightos-launcher.service)"
# A second launch proves the path unit fires again. Its endpoint never answers,
# so the client stays up; stopping the unit must end it (the client ignores
# SIGTERM, so the runner escalates) without marking the unit failed.
rdp_python "
import moonlightos_rdp as rdp
rdp.upsert_connection(rdp.Connection(id='rdp-hold', name='HOLD', host='127.0.0.1', port=33891,
    username='smoke', certificate='ab' * 32))
rdp.write_handoff('rdp-hold', '$RDP_SMOKE_PASSWORD', rdp.HANDOFF)
rdp.write_session_request('rdp-hold')
"
wait_for_file /run/moonlightos/rdp-hold-ready 'second Remote Desktop session'
pgrep -u moonlightos -f '^/usr/bin/sdl-freerdp3 /v:127.0.0.1 /port:33891' >/dev/null
systemctl stop moonlightos-rdp.service
systemctl show --property=Result,ExecMainStatus moonlightos-rdp.service
! systemctl is-failed --quiet moonlightos-rdp.service
! pgrep -u moonlightos -f '^/usr/bin/sdl-freerdp3' >/dev/null
test ! -e /run/moonlightos/rdp-session
test ! -e /run/moonlightos/rdp-session.secret
grep -qx 'exited: stopped' /run/moonlightos/rdp-hold-status
kill "$endpoint" 2>/dev/null || true
seed_rdp_state
verify_rdp_state
echo MOONLIGHTOS_SMOKE_RDP_READY
