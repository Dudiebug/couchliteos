#!/bin/bash
# Identify the machine and record the hardware facts MoonlightOS depends on,
# with the iMac Late 2013 checks from docs/IMAC-2013.md (section 0). Read-only:
# it changes no settings. Run it as root (sudo) so dmidecode can read the serial.
set -uo pipefail

EXPECTED_SERIAL=${MOONLIGHTOS_EXPECTED_SERIAL:-DCPM5026FQPG}
out=${1:-}
if [[ -z $out ]]; then
  directory=/var/log/moonlightos
  [[ -w $directory ]] || directory=${TMPDIR:-/tmp}
  out=$directory/hardware-report-$(date +%Y%m%d-%H%M%S).txt
fi

section() { printf '\n== %s ==\n' "$1"; }
run() { printf '$ %s\n' "$*"; "$@" 2>&1 || printf '(exit %s)\n' "$?"; }

report() {
  echo 'MoonlightOS hardware report'
  echo "Generated: $(date --iso-8601=seconds)"
  printf 'MoonlightOS: %s\n' "$(cat /etc/moonlightos-version 2>/dev/null || echo 'not running MoonlightOS')"
  sed -n 's/^Build profile: /Build profile: /p' /usr/share/moonlightos/build-info 2>/dev/null
  [[ $EUID -eq 0 ]] || echo 'WARNING: not running as root; dmidecode output and the serial number may be missing.'

  section 'Section 0 identification'
  run dmidecode -s system-product-name
  run dmidecode -s system-serial-number
  echo "$ lspci -nn | grep -iE 'vga|3d|net|audio'"
  lspci -nn 2>&1 | grep -iE 'vga|3d|net|audio'
  run lsusb

  section 'Checks'
  product=$(dmidecode -s system-product-name 2>/dev/null || cat /sys/class/dmi/id/product_name 2>/dev/null || true)
  serial=$(dmidecode -s system-serial-number 2>/dev/null || true)
  case $product in
    iMac14,2) echo "MODEL OK: $product (27-inch, 2560x1440, NVIDIA GT 755M / GTX 775M / GTX 780M)" ;;
    iMac14,3) echo "MODEL OK: $product (21.5-inch, 1920x1080, NVIDIA GT 750M)" ;;
    iMac14,1) echo "MODEL: $product is the 21.5-inch Intel Iris Pro iMac with no NVIDIA GPU; the iMac NVIDIA checks do not apply" ;;
    *) echo "MODEL: '${product:-unknown}' is not an iMac Late 2013 NVIDIA model; the iMac checks do not apply" ;;
  esac
  if [[ -z $serial ]]; then
    echo 'SERIAL UNKNOWN: run as root'
  elif [[ $serial == "$EXPECTED_SERIAL" ]]; then
    echo "SERIAL OK: $serial"
  else
    echo "SERIAL MISMATCH: $serial (expected $EXPECTED_SERIAL)"
  fi
  lspci -nn 2>/dev/null | grep -qiE '(vga|3d).*\[10de:' && echo 'GPU: NVIDIA present' || echo 'GPU: no NVIDIA device found'
  lspci -nn 2>/dev/null | grep -qi '\[14e4:43a0\]' && echo 'WI-FI: Broadcom BCM4360 [14e4:43a0] present' || echo 'WI-FI: BCM4360 [14e4:43a0] not found'
  lspci -nn 2>/dev/null | grep -qi '\[14e4:1682\]' && echo 'ETHERNET: Broadcom BCM57766 [14e4:1682] present' || echo 'ETHERNET: BCM57766 [14e4:1682] not found'
  grep -hs '^Codec:' /proc/asound/card*/codec#* | sort -u

  section 'Drivers'
  run lspci -nnk
  printf 'Loaded GPU/network/SMC/keyboard modules:\n'
  lsmod 2>/dev/null | grep -E '^(nouveau|nvidia[a-z_]*|i915|wl|b43|bcma|ssb|brcmsmac|tg3|applesmc|hid_apple|snd_hda_codec_cirrus|btusb) ' || true
  if lsmod 2>/dev/null | grep -q '^nvidia'; then
    case $product in
      iMac14,[23]) echo 'FAIL: a proprietary NVIDIA module is loaded on the Kepler GPU (it must use nouveau)' ;;
      *) echo 'nvidia: proprietary driver loaded' ;;
    esac
  fi
  lsmod 2>/dev/null | grep -q '^nouveau ' && echo 'nouveau: loaded'
  printf 'hid_apple fnmode: %s\n' "$(cat /sys/module/hid_apple/parameters/fnmode 2>/dev/null || echo 'module not loaded')"
  modinfo wl 2>/dev/null | grep -E '^(filename|version|vermagic):' || echo 'wl: module not found'
  grep -hE '^blacklist (b43|bcma|ssb|brcmsmac)$' /etc/modprobe.d/*.conf 2>/dev/null | sort -u

  section 'Hardware detection'
  /usr/libexec/moonlightos-hwdetect report 2>&1 || true

  section 'Boot'
  if [[ -d /sys/firmware/efi ]]; then
    echo 'Firmware: UEFI'
    secure=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | awk '{print $NF}')
    echo "Secure Boot: ${secure:-not reported (Apple EFI has none)}"
    cat /sys/firmware/efi/fw_platform_size 2>/dev/null | sed 's/^/EFI platform size: /'
  else
    echo 'Firmware: legacy BIOS'
  fi
  run cat /proc/cmdline

  section 'Display'
  for connector in /sys/class/drm/card*-*; do
    [[ -e $connector/status ]] || continue
    printf '%s: %s; first (preferred) mode: %s\n' "${connector##*/}" "$(cat "$connector/status")" "$(head -1 "$connector/modes" 2>/dev/null)"
  done
  command -v wlr-randr >/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]] && run wlr-randr

  section 'Sensors'
  command -v sensors >/dev/null && run sensors
  [[ -d /sys/devices/platform/applesmc.768 ]] && echo 'applesmc: present' || echo 'applesmc: not present'

  section 'Network, audio, Bluetooth'
  run ip -brief link
  command -v nmcli >/dev/null && run nmcli device status
  run rfkill list
  run aplay -l
}

report 2>&1 | tee "$out"
printf '\nSaved: %s\n' "$out"
