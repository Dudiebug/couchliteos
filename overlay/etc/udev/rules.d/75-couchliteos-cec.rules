# HDMI-CEC: start the TV-control daemon only when the kernel exposes a CEC adapter.
# group video (the launcher user is in it) so the TV CONTROL screen can run cec-ctl itself.
SUBSYSTEM=="cec", KERNEL=="cec[0-9]*", ACTION=="add", GROUP="video", MODE="0660", TAG+="systemd", ENV{SYSTEMD_WANTS}+="couchliteos-cec.service"
# Pulse-Eight USB-CEC adapter: attach its serial line to the kernel pulse8-cec driver.
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", ACTION=="add", ATTRS{idVendor}=="2548", ATTRS{idProduct}=="1001|1002", TAG+="systemd", ENV{SYSTEMD_WANTS}+="couchliteos-pulse8-inputattach@%k.service"
