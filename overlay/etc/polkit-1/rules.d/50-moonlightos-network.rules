// MoonlightOS: the first-boot wizard runs inside moonlightos-launcher.service as the
// unprivileged "moonlightos" user and joins Wi-Fi through NetworkManager's D-Bus API,
// which asks polkit first. Only the three actions that Wi-Fi join uses are granted,
// and only to processes of that service:
//   wifi.scan               nmcli device wifi rescan
//   settings.modify.system  add the new Wi-Fi profile, delete a replaced one
//   network-control         activate the new profile
// Settings > NETWORK > ADVANCED runs nmtui as a configured app, so nmtui (and only nmtui)
// in moonlightos-configured-app.service gets the same three actions.
// Firefox, Chrome, web apps and the terminal app run as the same user but in their own
// systemd units or as other programs, so they get nothing (no global DNS, hostname,
// hotspot or profile edits).
//
// The launcher is a plain systemd service with no logind session, so polkit reports
// subject.local and subject.active as false for it; a rule that required them would
// refuse the wizard. Its cgroup is what identifies it instead.
var moonlightosNetworkActions = {
    "org.freedesktop.NetworkManager.network-control": true,
    "org.freedesktop.NetworkManager.settings.modify.system": true,
    "org.freedesktop.NetworkManager.wifi.scan": true
};

function moonlightosProcFile(subject, name) {
    try {
        return polkit.spawn(["/usr/bin/cat", "/proc/" + subject.pid + "/" + name]);
    } catch (error) {
        return "";
    }
}

function moonlightosNetworkCaller(subject) {
    var cgroup = moonlightosProcFile(subject, "cgroup");
    if (cgroup.indexOf("/moonlightos-launcher.service") >= 0) {
        return true;
    }
    return cgroup.indexOf("/moonlightos-configured-app.service") >= 0 && moonlightosProcFile(subject, "comm") == "nmtui\n";
}

polkit.addRule(function(action, subject) {
    if (subject.user == "moonlightos" && moonlightosNetworkActions[action.id] === true && moonlightosNetworkCaller(subject)) {
        return polkit.Result.YES;
    }
});
