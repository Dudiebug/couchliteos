[Unit]
Description=Sleep requested by CouchLiteOS launcher

[Service]
Type=oneshot
# /run survives a suspend: drop the request first, or this path unit would
# suspend the machine again the moment it wakes up.
ExecStartPre=/usr/bin/rm -f /run/couchliteos/suspend
# A PC that cannot suspend is refused here even if a request file appears (the launcher
# and gamepad-nav already check): logind answers "Sleep verb 'suspend' is not configured
# or configuration is not supported by kernel" and this service fails without sleeping.
# No Condition/ExecCondition on purpose: a skipped unit would leave the request file behind.
ExecStart=/usr/bin/systemctl suspend
