[Unit]
Description=CouchLiteOS controller-friendly launcher
Requires=seatd.service
Wants=couchliteos-audio.service couchliteos-bluetooth.service couchliteos-hwdetect.service
After=seatd.service couchliteos-audio.service couchliteos-bluetooth.service couchliteos-hwdetect.service systemd-user-sessions.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=5
# Runs after every failed exit; the handler says on the TV that the screen could
# not start only once the restart limit above has been reached.
OnFailure=couchliteos-display-failed.service

[Service]
Type=simple
User=couchliteos
Group=couchliteos
SupplementaryGroups=audio input render video seat
Environment=HOME=/var/lib/couchliteos/home
Environment=XDG_CONFIG_HOME=/var/lib/couchliteos/home/.config
Environment=XDG_DATA_HOME=/var/lib/couchliteos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/couchliteos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/couchliteos
Environment=LIBSEAT_BACKEND=seatd
Environment=QT_QPA_PLATFORM=wayland
# GPU-specific compositor settings written at boot by couchliteos-hwdetect.
EnvironmentFile=-/run/couchliteos-hardware/compositor.env
StateDirectory=couchliteos
LogsDirectory=couchliteos
ExecStartPre=/usr/bin/rm -f /run/couchliteos/launcher-ready /run/couchliteos/session.env
# The log persists across boots: over 5 MiB it is cut to its last 5 MiB and kept as launcher.log.1.
# (systemd expands $$ and %% itself, so the shell sees $ and %.)
ExecStartPre=/bin/bash -c 'f=/var/log/couchliteos/launcher.log; if [ "$$(stat -c %%s "$$f" 2>/dev/null || echo 0)" -gt 5242880 ]; then tail -c 5242880 "$$f" > "$$f.1.new" && mv -f "$$f.1.new" "$$f.1" && : > "$$f"; fi; exit 0'
# couchliteos-session runs the TV interface, retries it without GL, then falls back to the
# classic launcher (curses in foot); the wait below (45 s) covers all three starts, each TV
# attempt getting 12 s for its first frame. Both grow with the QEMU tests' slow-down factor
# (fw_cfg; PCs have none), so the wait, not systemd's 90 s start limit, decides.
TimeoutStartSec=600
ExecStart=/bin/bash -o pipefail -c '/usr/bin/cage -s -- /usr/libexec/couchliteos-session 2>&1 | /usr/bin/tee -a /var/log/couchliteos/launcher.log'
ExecStartPost=/bin/bash -c 'read -r s 2>/dev/null < /sys/firmware/qemu_fw_cfg/by_name/opt/couchliteos.timeout-scale/raw; [[ $${s-} =~ ^[1-9]$$ ]] || s=1; for ((i = 0; i < 450 * s; i++)); do if test -e /run/couchliteos/launcher-ready; then echo COUCHLITEOS_LAUNCHER_READY; exit 0; fi; sleep 0.1; done; exit 1'
Restart=always
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
