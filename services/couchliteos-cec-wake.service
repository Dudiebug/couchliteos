[Unit]
Description=Turn the TV on again after resume (HDMI-CEC)
ConditionPathExistsGlob=/dev/cec[0-9]*
After=suspend.target

[Service]
Type=oneshot
# A fresh daemon run switches the TV on (if enabled) and ignores the TV's own
# Standby for a minute; it does nothing without a CEC adapter.
ExecStart=/usr/bin/systemctl restart couchliteos-cec.service

[Install]
WantedBy=suspend.target
