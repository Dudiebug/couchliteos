[Unit]
Description=MoonlightOS chiaki-ng client
After=moonlightos-launcher.service
ConditionFileIsExecutable=/opt/moonlightos/apps/chiaki-ng/usr/bin/chiaki
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=moonlightos-path-rearm@chiaki.service

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio input render video
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_DATA_HOME=/var/lib/moonlightos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/moonlightos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=PIPEWIRE_RUNTIME_DIR=/run/moonlightos
Environment=WAYLAND_DISPLAY=wayland-0
Environment=QT_QPA_PLATFORM=wayland
Environment=SDL_AUDIODRIVER=pipewire
EnvironmentFile=-/run/moonlightos/session.env
ExecStart=/usr/libexec/moonlightos-run-app chiaki-ng
Restart=on-failure
# Restart directly: with the default mode OnFailure= fires on every retried
# crash, which would reset the start limit and retry forever.
RestartMode=direct
RestartSec=2
StandardOutput=journal+console
StandardError=journal+console
