[Unit]
Description=MoonlightOS hardware detection: graphics driver and decode hints
After=systemd-udev-trigger.service systemd-modules-load.service moonlightos-hwdetect-early.service
Before=moonlightos-launcher.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/moonlightos-hwdetect late
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
