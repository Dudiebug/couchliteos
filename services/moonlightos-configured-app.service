[Unit]
Description=MoonlightOS configured application
After=moonlightos-launcher.service
ConditionPathExists=/run/moonlightos/launch-app.request
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=moonlightos-path-rearm@configured-app.service

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio input render video
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_DATA_HOME=/var/lib/moonlightos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/moonlightos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=PIPEWIRE_RUNTIME_DIR=/run/moonlightos
Environment=WAYLAND_DISPLAY=wayland-0
EnvironmentFile=-/run/moonlightos/session.env
ExecStart=/usr/libexec/moonlightos-run-configured-app
KillMode=control-group
TimeoutStopSec=10
StandardOutput=journal+console
StandardError=journal+console
