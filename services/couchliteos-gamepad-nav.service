[Unit]
Description=CouchLiteOS launcher gamepad navigation
After=couchliteos-launcher.service
PartOf=couchliteos-launcher.service

[Service]
Type=simple
User=couchliteos
Group=couchliteos
# video: the keyboard's brightness keys write the backlight (70-couchliteos-backlight.rules).
SupplementaryGroups=input video
# The volume keys run wpctl like the launcher does: same user, PipeWire's socket in this directory.
Environment=XDG_RUNTIME_DIR=/run/couchliteos
EnvironmentFile=-/run/couchliteos/session.env
ExecStart=/usr/libexec/couchliteos-gamepad-nav
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/couchliteos/gamepad-nav.log
StandardError=append:/var/log/couchliteos/gamepad-nav.log

[Install]
WantedBy=graphical.target
