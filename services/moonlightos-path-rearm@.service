[Unit]
Description=Re-arm moonlightos-%i.path after its service hit the start limit

[Service]
Type=oneshot
# A service that hits its start limit also fails the path unit that triggers it
# (unit-start-limit-hit), which would ignore every later launch request until
# reboot. Clear the counter and restart the path; a request still waiting on
# disk is then started immediately.
ExecStart=/usr/bin/systemctl reset-failed moonlightos-%i.service moonlightos-%i.path
ExecStart=/usr/bin/systemctl restart moonlightos-%i.path
StandardOutput=journal
