[Unit]
Description=CouchLiteOS Moonlight client
After=couchliteos-launcher.service
ConditionFileIsExecutable=/opt/couchliteos/apps/moonlight/usr/bin/moonlight
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=couchliteos-path-rearm@moonlight.service

[Service]
Type=simple
User=couchliteos
Group=couchliteos
SupplementaryGroups=audio input render video
Environment=HOME=/var/lib/couchliteos/home
Environment=XDG_CONFIG_HOME=/var/lib/couchliteos/home/.config
Environment=XDG_DATA_HOME=/var/lib/couchliteos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/couchliteos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/couchliteos
Environment=PIPEWIRE_RUNTIME_DIR=/run/couchliteos
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
EnvironmentFile=-/run/couchliteos/session.env
ExecStart=/usr/libexec/couchliteos-run-app moonlight
# run-app exits 0 after a failed auto-stream (its one-shot request is used up), so this
# restarts only ordinary crashes and the launcher can show its error screen.
Restart=on-failure
# Restart directly: with the default mode OnFailure= fires on every retried
# crash, which would reset the start limit and retry forever.
RestartMode=direct
RestartSec=2
StandardOutput=journal+console
StandardError=journal+console
