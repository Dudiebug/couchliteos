[Unit]
Description=CouchLiteOS hardware detection: kernel module policy
DefaultDependencies=no
After=systemd-journald.socket
Before=systemd-udevd.service systemd-udev-trigger.service systemd-modules-load.service sysinit.target
ConditionPathIsDirectory=/sys/bus/pci

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/couchliteos-hwdetect early

[Install]
WantedBy=sysinit.target
