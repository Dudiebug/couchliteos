[Unit]
Description=Export a redacted MoonlightOS support archive
ConditionPathExists=/run/moonlightos/support-export.request

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/moonlightos-support-export
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_SETGID CAP_SETUID CAP_SYS_ADMIN CAP_SYSLOG
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=no
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
InaccessiblePaths=/var/lib/moonlightos/home /var/lib/tailscale -/var/lib/bluetooth -/var/lib/moonlightos/rdp-secrets -/run/moonlightos/rdp-session.secret -/run/moonlightos/rdp-secret.request
ReadOnlyPaths=/var/lib/moonlightos/config.ini /var/log/moonlightos
ReadWritePaths=/run/moonlightos
StandardOutput=journal
StandardError=journal
