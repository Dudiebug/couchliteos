[Unit]
Description=CouchLiteOS: live USB boot reached the launcher: mark the update slot booted, finish a Ventoy update
After=couchliteos-launcher.service
Wants=couchliteos-launcher.service
# Live sticks only, and only once the launcher is up. A boot that never gets there leaves its slot
# unmarked, and a Ventoy update keeps the old ISO in Ventoy's menu until the new one gets here.
# Not limited to a pending Ventoy update: a dd/Etcher stick's update slot needs the marker too.
ConditionPathExists=/run/live/medium
ConditionPathExists=/run/couchliteos/launcher-ready

[Service]
Type=oneshot
# The "-" makes a failure count as success: tidying up must never fail the boot.
ExecStart=-/usr/libexec/couchliteos-live-boot-ok
ExecStart=-/usr/libexec/couchliteos-persist-setup boot-ok
Nice=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
