[Unit]
Description=Save, remove, or hand off a MoonlightOS Remote Desktop password
ConditionPathExists=/run/moonlightos/rdp-secret.request
# Requests come in quick bursts (save, then connect); a start limit would stop
# the path unit and disable saved passwords until reboot.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/moonlightos-rdp-secret request
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/moonlightos /run/moonlightos
InaccessiblePaths=/var/lib/moonlightos/home -/var/lib/tailscale -/var/lib/bluetooth
StandardOutput=journal
StandardError=journal
