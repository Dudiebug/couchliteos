[Unit]
Description=Tell the TV that the MoonlightOS screen could not start
# Started by OnFailure= of moonlightos-launcher.service (never enabled). The
# script only shows its message once the launcher has given up for good.

[Service]
Type=oneshot
ExecStart=/usr/libexec/moonlightos-display-failed
TimeoutStartSec=10
PrivateNetwork=yes
NoNewPrivileges=yes
