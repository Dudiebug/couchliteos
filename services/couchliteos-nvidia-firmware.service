[Unit]
Description=Fetch or remove the opt-in NVIDIA video decoder firmware for nouveau
ConditionPathExists=/run/couchliteos/nvidia-firmware.request
OnFailure=couchliteos-path-rearm@nvidia-firmware.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/couchliteos-nvidia-firmware
UMask=0022
TimeoutStartSec=15min
NoNewPrivileges=yes
# /run/couchliteos is 0700 couchliteos: root needs DAC_OVERRIDE to read the request there.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# The firmware search path lives in /sys, so ProtectKernelTunables stays off;
# writes are limited to it, the firmware store, the status file and config.ini
# (a verified decoder turns [moonlight] decoder = software back to auto).
ReadWritePaths=/run/couchliteos /var/lib/couchliteos/firmware -/var/lib/couchliteos/config.ini /sys/module/firmware_class/parameters/path
InaccessiblePaths=/var/lib/couchliteos/home /var/lib/tailscale -/var/lib/bluetooth -/var/lib/couchliteos/rdp-secrets
ExecStartPre=+/usr/bin/install -d -m 0755 /var/lib/couchliteos/firmware
StandardOutput=journal
StandardError=journal
