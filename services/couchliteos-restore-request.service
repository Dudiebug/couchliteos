[Unit]
Description=Restore the saved previous CouchLiteOS version at the next start, requested by the launcher

[Service]
Type=oneshot
User=root
Group=root
# Drop the request first, or this path unit would start the service again the moment it ends.
ExecStartPre=/usr/bin/rm -f /run/couchliteos/restore-request
# Leaves /var/lib/couchliteos-update/snapshot/restore-request (root's own) and restarts the box;
# couchliteos-restore.service then restores before the launcher starts. While an update holds
# the updater's lock this exits 1 and nothing is requested.
ExecStart=/usr/libexec/couchliteos-updater request-restore
StandardOutput=journal
StandardError=journal
