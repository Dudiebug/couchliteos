[Unit]
Description=MoonlightOS controller-friendly launcher
Requires=seatd.service
Wants=moonlightos-audio.service moonlightos-bluetooth.service moonlightos-hwdetect.service
After=seatd.service moonlightos-audio.service moonlightos-bluetooth.service moonlightos-hwdetect.service systemd-user-sessions.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio input render video seat
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_DATA_HOME=/var/lib/moonlightos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/moonlightos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=LIBSEAT_BACKEND=seatd
Environment=QT_QPA_PLATFORM=wayland
# GPU-specific compositor settings written at boot by moonlightos-hwdetect.
EnvironmentFile=-/run/moonlightos-hardware/compositor.env
StateDirectory=moonlightos
LogsDirectory=moonlightos
ExecStartPre=/usr/bin/rm -f /run/moonlightos/launcher-ready /run/moonlightos/session.env
ExecStart=/bin/bash -o pipefail -c '/usr/bin/cage -s -- /usr/libexec/moonlightos-foot --fullscreen --title "MoonlightOS Launcher" /usr/libexec/moonlightos-launcher 2>&1 | /usr/bin/tee -a /var/log/moonlightos/launcher.log'
ExecStartPost=/bin/bash -c 'for i in {1..100}; do if test -e /run/moonlightos/launcher-ready; then echo MOONLIGHTOS_LAUNCHER_READY; exit 0; fi; sleep 0.1; done; exit 1'
Restart=always
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
