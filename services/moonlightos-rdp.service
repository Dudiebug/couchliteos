[Unit]
Description=MoonlightOS Remote Desktop session
After=moonlightos-launcher.service moonlightos-audio.service
# A new launcher request, or the session being recovered after a crash.
ConditionPathExists=|/run/moonlightos/rdp.request
ConditionPathExists=|/run/moonlightos/rdp-session
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=moonlightos-rdp-cleanup.service

[Service]
Type=simple
User=moonlightos
Group=moonlightos
SupplementaryGroups=audio input render video
Environment=HOME=/var/lib/moonlightos/home
Environment=XDG_CONFIG_HOME=/var/lib/moonlightos/home/.config
Environment=XDG_DATA_HOME=/var/lib/moonlightos/home/.local/share
Environment=XDG_CACHE_HOME=/var/lib/moonlightos/home/.cache
Environment=XDG_RUNTIME_DIR=/run/moonlightos
Environment=PIPEWIRE_RUNTIME_DIR=/run/moonlightos
Environment=WAYLAND_DISPLAY=wayland-0
EnvironmentFile=-/run/moonlightos/session.env
# Nothing in this unit runs as root: its environment is the appliance user's.
# Saved passwords are staged beforehand by moonlightos-rdp-secret.service.
ExecStart=/usr/libexec/moonlightos-run-configured-app --rdp
Restart=on-failure
RestartSec=2
# 65: authentication, certificate, or configuration failure; never retry
# (retrying a wrong password can lock the account).
RestartPreventExitStatus=65 66
# A stop request (130/143) ends the session normally rather than failing it.
SuccessExitStatus=130 143
KillMode=control-group
TimeoutStopSec=10
StandardOutput=journal+console
StandardError=journal+console
