[Unit]
Description=MoonlightOS HDMI-CEC TV control
# Started by udev when a CEC device appears; does nothing without one.
ConditionPathExistsGlob=/dev/cec[0-9]*
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/libexec/moonlightos-cec
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal
StandardError=journal
