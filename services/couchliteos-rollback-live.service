[Unit]
Description=Make the earlier system on the CouchLiteOS USB stick the one that starts next (requested by the launcher)

[Service]
Type=oneshot
User=root
Group=root
# Drop the request first, or this path unit would start another rollback the moment this one ends.
ExecStartPre=/usr/bin/rm -f /run/couchliteos/rollback-live
# The updater refuses anywhere but a live stick with its own storage and an earlier system kept.
ExecStart=/usr/libexec/couchliteos-updater rollback-live
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
