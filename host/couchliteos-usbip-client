#!/bin/bash
set -Eeuo pipefail

CONFIG=${COUCHLITEOS_USBIP_CLIENT_CONFIG:-/etc/couchliteos-usbip-client.conf}
[[ -r "$CONFIG" ]] || { echo "Missing $CONFIG" >&2; exit 78; }
# This file is root-owned configuration. Only simple name=value assignments are accepted.
SERVER_IP=$(sed -n 's/^[[:space:]]*SERVER_IP[[:space:]]*=[[:space:]]*//p' "$CONFIG" | tail -1)
POLL_SECONDS=$(sed -n 's/^[[:space:]]*POLL_SECONDS[[:space:]]*=[[:space:]]*//p' "$CONFIG" | tail -1)
POLL_SECONDS=${POLL_SECONDS:-5}

python3 - "$SERVER_IP" <<'PY'
import ipaddress, sys
try:
    value = ipaddress.ip_address(sys.argv[1])
except ValueError:
    raise SystemExit("SERVER_IP must be a literal IPv4 address")
if value.version != 4 or value.is_unspecified:
    raise SystemExit("SERVER_IP must be a literal IPv4 address")
PY
[[ "$POLL_SECONDS" =~ ^[1-9][0-9]?$ ]] || { echo 'POLL_SECONDS must be 1-99' >&2; exit 78; }

remote_busids() {
  usbip list --remote="$SERVER_IP" 2>/dev/null |
    sed -n 's/^[[:space:]]*\([0-9][0-9.-]*\):.*/\1/p'
}

attached_busids() {
  usbip port 2>/dev/null | sed -n 's/.*remote bus\/dev.*\/\([^/]*\)$/\1/p'
}

attach_missing() {
  local busid
  mapfile -t attached < <(attached_busids)
  while IFS= read -r busid; do
    [[ -n "$busid" ]] || continue
    if ! printf '%s\n' "${attached[@]:-}" | grep -Fxq "$busid"; then
      usbip attach --remote="$SERVER_IP" --busid="$busid" || true
    fi
  done < <(remote_busids)
}

case ${1:-watch} in
  once) modprobe vhci_hcd; attach_missing ;;
  watch)
    modprobe vhci_hcd
    while true; do attach_missing; sleep "$POLL_SECONDS"; done
    ;;
  detach-all)
    while IFS= read -r port; do usbip detach --port="$port" || true; done < <(usbip port | sed -n 's/^Port \([0-9][0-9]*\):.*/\1/p')
    ;;
  status) usbip port; usbip list --remote="$SERVER_IP" ;;
  *) echo 'Usage: couchliteos-usbip-client {once|watch|detach-all|status}' >&2; exit 64 ;;
esac
