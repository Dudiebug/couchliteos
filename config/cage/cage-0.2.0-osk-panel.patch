+bool
+view_is_osk(struct cg_view *view)
+{
+	if (view->type != CAGE_XDG_SHELL_VIEW)
+		return false;
+	struct cg_xdg_shell_view *xdg_shell_view = (struct cg_xdg_shell_view *) view;
+	const char *app_id = xdg_shell_view->xdg_toplevel ? xdg_shell_view->xdg_toplevel->app_id : NULL;
+	return app_id && strcmp(app_id, CAGE_OSK_APP_ID) == 0;
+}
+
+/* The open (mapped) keyboard, or NULL. */
+struct cg_view *
+view_find_osk(struct cg_server *server)
+{
+	struct cg_view *view;
+	wl_list_for_each (view, &server->views, link) {
+		if (view->scene_tree && view_is_osk(view))
+			return view;
+	}
+	return NULL;
+}
+
+/* The keyboard panel is drawn above every other view, including one mapped or
+   raised while it is open. */
+void
+view_raise_osk(struct cg_server *server)
+{
+	struct cg_view *osk = view_find_osk(server);
+	if (osk)
+		wlr_scene_node_raise_to_top(&osk->scene_tree->node);
+}
