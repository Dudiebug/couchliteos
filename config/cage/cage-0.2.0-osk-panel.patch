+/* The output showing the view the keyboard types into: the focused view, or the
+   first other one once the keyboard has the focus. NULL when there is none. */
+static struct wlr_output *
+osk_output(struct cg_view *osk)
+{
+	struct cg_server *server = osk->server;
+	struct cg_view *target = seat_get_focus(server->seat);
+	if (!target || view_is_osk(target)) {
+		struct cg_view *view;
+		target = NULL;
+		wl_list_for_each (view, &server->views, link) {
+			if (!view_is_osk(view)) {
+				target = view;
+				break;
+			}
+		}
+	}
+	if (!target)
+		return NULL;
+
+	int width, height;
+	target->impl->get_geometry(target, &width, &height);
+	return wlr_output_layout_output_at(server->output_layout, target->lx + width / 2.0,
+					   target->ly + height / 2.0);
+}
+
+/* Full width, CAGE_OSK_PANEL_SHARE of the height, at the bottom of that output
+   (of the whole layout when it is not known). */
+static void
+view_dock_osk(struct cg_view *view, struct wlr_box *layout_box)
+{
+	struct wlr_box box = *layout_box;
+	struct wlr_output *output = osk_output(view);
+	if (output) {
+		wlr_output_layout_get_box(view->server->output_layout, output, &box);
+		if (wlr_box_empty(&box))
+			box = *layout_box;
+	}
+
+	int height = (int) (box.height * CAGE_OSK_PANEL_SHARE);
+	if (height < CAGE_OSK_PANEL_MIN_HEIGHT)
+		height = CAGE_OSK_PANEL_MIN_HEIGHT;
+	if (height > box.height)
+		height = box.height;
+
+	view->lx = box.x;
+	view->ly = box.y + box.height - height;
+
+	if (view->scene_tree) {
+		wlr_scene_node_set_position(&view->scene_tree->node, view->lx, view->ly);
+	}
+
+	view->impl->maximize(view, box.width, height);
+}
