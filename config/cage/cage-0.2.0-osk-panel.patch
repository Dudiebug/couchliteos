+	/* While the keyboard panel is open it keeps the keyboard focus, whatever asks
+	   for it (a click, an activation request, a view mapped or destroyed). The
+	   view only moves to the front, so it is focused when the keyboard closes. */
+	struct cg_view *osk = view_find_osk(server);
+	if (osk && osk != view) {
+		if (!view_is_primary(view)) {
+			wl_list_remove(&view->link);
+			wl_list_insert(&server->views, &view->link);
+		}
+		return;
+	}
+
 	if (prev_view) {
 		view_activate(prev_view, false);
 	}
