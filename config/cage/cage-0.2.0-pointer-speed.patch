 	map_input_device_to_output(seat, &wlr_pointer->base, wlr_pointer->output_name);
+
+	double speed = 0.0;
+	bool have_speed = read_pointer_speed(&speed);
+	pointer_apply_speed(wlr_pointer, have_speed, speed);
 }
 
