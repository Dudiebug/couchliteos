+/* Reads the mouse and touchpad speed (libinput acceleration, -1 to 1) chosen in
+   the launcher's settings. False when the file is missing or does not hold a number. */
+static bool
+read_pointer_speed(double *speed)
+{
+	FILE *file = fopen(CAGE_POINTER_SPEED_PATH, "r");
+	if (!file)
+		return false;
+
+	char buffer[32];
+	bool valid = false;
+	if (fgets(buffer, sizeof(buffer), file)) {
+		char *end;
+		errno = 0;
+		double value = strtod(buffer, &end);
+		while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n')
+			end++;
+		if (end != buffer && *end == '\0' && errno == 0 && isfinite(value)) {
+			*speed = value < -1.0 ? -1.0 : value > 1.0 ? 1.0 : value;
+			valid = true;
+		}
+	}
+	fclose(file);
+	if (!valid)
+		wlr_log(WLR_ERROR, "Ignoring %s: not a number", CAGE_POINTER_SPEED_PATH);
+	return valid;
+}
+
+/* Without a speed setting the device keeps (or goes back to) libinput's default. */
+static void
+pointer_apply_speed(struct wlr_pointer *wlr_pointer, bool have_speed, double speed)
+{
+	struct wlr_input_device *device = &wlr_pointer->base;
+	if (!wlr_input_device_is_libinput(device))
+		return;
+
+	struct libinput_device *handle = wlr_libinput_get_device_handle(device);
+	if (!libinput_device_config_accel_is_available(handle))
+		return;
+
+	/* The controller's mouse has its own speed setting: keep libinput's default. */
+	if (device->name && strcmp(device->name, CAGE_CONTROLLER_MOUSE_NAME) == 0)
+		have_speed = false;
+	if (!have_speed)
+		speed = libinput_device_config_accel_get_default_speed(handle);
+	if (libinput_device_config_accel_set_speed(handle, speed) != LIBINPUT_CONFIG_STATUS_SUCCESS) {
+		wlr_log(WLR_ERROR, "Cannot set pointer speed %.2f on %s", speed, device->name);
+		return;
+	}
+	wlr_log(WLR_INFO, "Pointer speed %.2f on %s", speed, device->name);
+}
+
+void
+seat_apply_pointer_speed(struct cg_seat *seat)
+{
+	double speed = 0.0;
+	bool have_speed = read_pointer_speed(&speed);
+
+	struct cg_pointer *pointer;
+	wl_list_for_each (pointer, &seat->pointers, link) {
+		pointer_apply_speed(pointer->pointer, have_speed, speed);
+	}
+}
+
 static void
 handle_new_pointer(struct cg_seat *seat, struct wlr_pointer *wlr_pointer)
 {
@@ -221,6 +290,10 @@
