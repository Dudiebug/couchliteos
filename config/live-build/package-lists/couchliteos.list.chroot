linux-image-amd64
live-boot
live-config
systemd-sysv
dbus-user-session
sudo
network-manager
wpasupplicant
# NetworkManager asks polkit before the launcher user (the first-boot wizard) may add a Wi-Fi profile.
polkitd
iproute2
iputils-ping
ethtool
curl
ca-certificates
nftables
kmod
udev
rfkill

# Mesa graphics, Vulkan, VA-API, and diagnostics. GPU-specific firmware and
# drivers come from the build profile (config/profiles/<profile>/package-lists).
mesa-vulkan-drivers
libgl1-mesa-dri
libegl-mesa0
vulkan-tools
libva2
vainfo

# Kiosk Wayland and applications
cage
seatd
xwayland
foot
wlr-randr
firefox-esr
google-chrome-stable
wlrctl
libavcodec61
gamescope/trixie-backports
python3
python3-evdev
python3-dbus
python3-gi
libhidapi-hidraw0
libopengl0
qrencode
# Remote Desktop: FreeRDP 3 SDL3 client (native Wayland, no Xwayland)
freerdp3-sdl

# Audio and input
pipewire
pipewire-audio
wireplumber
alsa-utils
libspa-0.2-modules
libspa-0.2-bluetooth
joystick
