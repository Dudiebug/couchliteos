# Base, boot, init, and network
linux-image-amd64
live-boot
live-config
systemd-sysv
dbus-user-session
sudo
network-manager
wpasupplicant
# NetworkManager asks polkit before the launcher user (the first-boot wizard) may add a Wi-Fi profile.
polkitd
iproute2
iputils-ping
ethtool
curl
ca-certificates
nftables
kmod
udev
rfkill
# A zstd initrd (overlay/etc/initramfs-tools/conf.d/couchliteos.conf)
zstd

# Mesa graphics, Vulkan, VA-API, and diagnostics. GPU-specific firmware and
# drivers come from the build profile (config/profiles/<profile>/package-lists).
mesa-vulkan-drivers
libgl1-mesa-dri
libegl-mesa0
vulkan-tools
libva2
vainfo

# Kiosk Wayland and applications
cage
seatd
xwayland
foot
wlr-randr
firefox-esr
google-chrome-stable
wlrctl
libavcodec61
gamescope/trixie-backports
python3
python3-evdev
python3-dbus
python3-gi
libhidapi-hidraw0
libopengl0
qrencode
# Remote Desktop: FreeRDP 3 SDL3 client (native Wayland, no Xwayland)
freerdp3-sdl

# Audio and input
pipewire
pipewire-audio
wireplumber
alsa-utils
# apt-recommends is off, so libasound2-data's Recommends must be listed. SOF and AMD ACP
# cards (most recent laptops) need the UCM files for any sound and to list HDMI/DP outputs.
alsa-ucm-conf
alsa-topology-conf
libspa-0.2-modules
libspa-0.2-bluetooth
joystick
bluez
steam-devices
systemd-timesyncd
# HDMI-CEC TV control: cec-ctl talks to /dev/cec*; inputattach binds Pulse-Eight USB-CEC adapters
v4l-utils
inputattach

# USB/IP and diagnostics
usbip
usbutils
pciutils
jq
tailscale=1.102.3

# Software update: couchliteos-updater copies the new system over the installed one
rsync

# Debian Installer integration
debian-installer-launcher
