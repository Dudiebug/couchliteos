#!/bin/bash
set -Eeuo pipefail

# Debian live-build intentionally waits forever at its default boot menus.
# An appliance must select the live entry without a keyboard, for both BIOS
# (isolinux) and x86_64 UEFI (GRUB).
while IFS= read -r -d '' cfg; do
  sed -i '/^set default=/d; /^set timeout=/d; /^serial --unit=0 /d; /^terminal_input console serial$/d; /^terminal_output console serial$/d' "$cfg"
  sed -i '1i set default=0\nset timeout=3\nserial --unit=0 --speed=115200 --word=8 --parity=no --stop=1\nterminal_input console serial\nterminal_output console serial' "$cfg"
done < <(find . -type f -name grub.cfg -print0)

while IFS= read -r -d '' cfg; do
  sed -i 's/menuentry "Live system (amd64)"/menuentry "Start CouchLiteOS"/' "$cfg"
  grep -Fq 'menuentry "Start CouchLiteOS (No Persistence)"' "$cfg" && continue
  output=$(mktemp "${cfg}.XXXXXX")
  awk '
    /^menuentry "Start CouchLiteOS"/ && !done { capture=1 }
    capture { block=block $0 ORS }
    capture && /^}/ {
      printf "%s", block
      sub(/"Start CouchLiteOS"[^\{]*/, "\"Start CouchLiteOS (No Persistence)\" ", block)
      gsub(/ persistence /, " nopersistence ", block)
      printf "%s", block
      block=""; capture=0; done=1; next
    }
    !capture { print }
  ' "$cfg" > "$output"
  chmod 0555 "$output"
  mv "$output" "$cfg"
done < <(find . -type f -path '*/boot/grub/grub.cfg' -print0)

# A system update installed on the stick boots first. On sticks written with Etcher or dd
# the ISO partition is read-only, so updates go to live-update/{current,previous} on the
# stick's data area (launcher/couchliteos_liveslot.py), labelled couchliteos-sys or
# persistence. An entry appears only when its slot's `ok` marker exists (written last,
# after every file was checked); without one, the stick boots its own system as before.
# live-media= and live-media-path= are live-boot's options for where filesystem.squashfs
# lives. Indented entries keep the ISO's own entries first in every `^menuentry` listing.
while IFS= read -r -d '' cfg; do
  grep -Fq '# couchliteos live-update' "$cfg" && continue
  args=$(awk '/^menuentry "Start CouchLiteOS"/ { c=1 }
    c && /^[[:space:]]*linux[[:space:]]/ { sub(/^[[:space:]]*linux[[:space:]]+[^[:space:]]+[[:space:]]*/, ""); print; exit }' "$cfg")
  [[ -n $args ]] || { echo "0100-autoboot: no Start CouchLiteOS entry in $cfg" >&2; exit 1; }
  block=$(cat <<EOF
# couchliteos live-update
set couchliteos_slot=
set couchliteos_slot_label=
if search --no-floppy --label --set=couchliteos_slot couchliteos-sys; then
  set couchliteos_slot_label=couchliteos-sys
elif search --no-floppy --label --set=couchliteos_slot persistence; then
  set couchliteos_slot_label=persistence
fi
if [ -n "\${couchliteos_slot}" ]; then
  export couchliteos_slot
  export couchliteos_slot_label
  if [ -f "(\${couchliteos_slot})/live-update/current/ok" ]; then
    menuentry "Start CouchLiteOS (Updated)" {
      linux (\${couchliteos_slot})/live-update/current/vmlinuz $args live-media=/dev/disk/by-label/\${couchliteos_slot_label} live-media-path=/live-update/current
      initrd (\${couchliteos_slot})/live-update/current/initrd.img
    }
  fi
  if [ -f "(\${couchliteos_slot})/live-update/previous/ok" ]; then
    menuentry "Start CouchLiteOS (Previous Update)" {
      linux (\${couchliteos_slot})/live-update/previous/vmlinuz $args live-media=/dev/disk/by-label/\${couchliteos_slot_label} live-media-path=/live-update/previous
      initrd (\${couchliteos_slot})/live-update/previous/initrd.img
    }
  fi
fi
# end couchliteos live-update
EOF
)
  output=$(mktemp "${cfg}.XXXXXX")
  BLOCK=$block awk '
    /^menuentry "Start CouchLiteOS"/ && !done { print ENVIRON["BLOCK"]; done=1 }
    { print }
    END { if (!done) exit 1 }
  ' "$cfg" > "$output"
  chmod --reference="$cfg" "$output"
  mv "$output" "$cfg"
done < <(find . -type f -path '*/boot/grub/grub.cfg' -print0)

while IFS= read -r -d '' cfg; do
  sed -i "s/menuentry 'Start installer'/menuentry 'Install CouchLiteOS'/" "$cfg"
  sed -i 's/vga=788 ipv6.disable=1/vga=788 theme=dark ipv6.disable=1/g' "$cfg"
done < <(find . -type f -path '*/boot/grub/install*.cfg' -print0)

while IFS= read -r -d '' cfg; do
  printf '%s\n' \
    'set color_normal=white/black' \
    'set color_highlight=black/white' \
    'set menu_color_normal=white/black' \
    'set menu_color_highlight=black/white' \
    'unset theme' > "$cfg"
done < <(find . -type f -path '*/boot/grub/theme.cfg' -print0)

while IFS= read -r -d '' cfg; do
  sed -i '/^timeout /d' "$cfg"
  printf '\ntimeout 30\n' >> "$cfg"
done < <(find . -type f -name isolinux.cfg -print0)

while IFS= read -r -d '' cfg; do
  grep -Fq 'menu label Start CouchLiteOS (No Persistence)' "$cfg" && continue
  output=$(mktemp "${cfg}.XXXXXX")
  awk 'BEGIN { RS=""; ORS="\n\n" }
    $1 == "label" && $2 == "live-amd64" {
      gsub(/menu label \^Live system \(amd64\)/, "menu label ^Start CouchLiteOS")
      print
      sub(/^label live-amd64/, "label live-amd64-nopersistence")
      gsub(/menu label \^Start CouchLiteOS/, "menu label Start CouchLiteOS (No Persistence)")
      gsub(/\n[[:space:]]*menu default/, "")
      gsub(/ persistence /, " nopersistence ")
      print
      next
    }
    { print }
  ' "$cfg" > "$output"
  chmod --reference="$cfg" "$output"
  mv "$output" "$cfg"
done < <(find . -type f -path '*/isolinux/live.cfg' -print0)

while IFS= read -r -d '' cfg; do
  sed -i 's/menu label Start \^installer/menu label ^Install CouchLiteOS/' "$cfg"
  sed -i 's/vga=788 ipv6.disable=1/vga=788 theme=dark ipv6.disable=1/g' "$cfg"
done < <(find . -type f -path '*/isolinux/install.cfg' -print0)

while IFS= read -r -d '' cfg; do
  sed -i '/^menu background /d; /^menu color /d' "$cfg"
  printf '%s\n' \
    'menu color screen    * #ffffffff #00000000 std' \
    'menu color title     * #ffffffff #00000000 std' \
    'menu color border    * #ffffffff #00000000 std' \
    'menu color sel       * #ff000000 #ffffffff *' \
    'menu color hotsel    1;7;30;47 #ff000000 #ffffffff *' \
    'menu color tabmsg    * #ffffffff #00000000 std' \
    'menu color help      37;40 #ffffffff #00000000 std' >> "$cfg"
done < <(find . -type f -path '*/isolinux/stdmenu.cfg' -print0)
