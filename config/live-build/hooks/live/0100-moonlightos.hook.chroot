#!/bin/bash
set -Eeuo pipefail

if ! getent group moonlightos >/dev/null; then
  groupadd --system moonlightos
fi
if ! getent group seat >/dev/null; then
  groupadd --system seat
fi
if ! id moonlightos >/dev/null 2>&1; then
  useradd --uid 1000 --gid moonlightos --groups audio,input,render,video,seat \
    --home-dir /var/lib/moonlightos/home --create-home --shell /bin/bash moonlightos
fi

install -d -o moonlightos -g moonlightos -m 0750 \
  /var/lib/moonlightos /var/lib/moonlightos/home /var/lib/moonlightos/apps.d \
  /var/lib/moonlightos/rdp /var/log/moonlightos

cat > /var/lib/moonlightos/config.ini <<'EOF'
[launcher]
autostart = none

[display]
output =
identity =
resolution =
refresh_mhz =

[moonlight]
resolution = 1920x1080
fps = 60
codec = auto
decoder = auto
fullscreen = true

[chiaki-ng]
gamescope = false

[tailscale]
enabled = false
accept_dns = true
ssh_enabled = false
host_address_mode = auto
remote_usbip = false
allowed_usbip_peer =
node_name =

[host:gaming-pc]
lan_address =
tailscale_hostname =
tailscale_ip =
address_mode = auto
app =
EOF

chown -R moonlightos:moonlightos /var/lib/moonlightos /var/log/moonlightos
chmod 0640 /var/lib/moonlightos/config.ini
# Saved Remote Desktop passwords: root-only, created after the recursive chown.
install -d -o root -g root -m 0700 /var/lib/moonlightos/rdp-secrets

install -d -o root -g root -m 0700 /var/lib/tailscale
cat > /etc/apt/sources.list.d/tailscale.list <<'EOF'
deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian trixie main
EOF
cat > /etc/apt/sources.list.d/google-chrome.list <<'EOF'
deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.asc] https://dl.google.com/linux/chrome/deb/ stable main
EOF
chmod 0644 /etc/apt/sources.list.d/{tailscale,google-chrome}.list \
  /usr/share/keyrings/{tailscale-archive-keyring.gpg,google-chrome.asc}

systemctl enable NetworkManager.service NetworkManager-wait-online.service
systemctl enable systemd-timesyncd.service
systemctl enable seatd.service moonlightos-network-ready.service
systemctl enable moonlightos-firewall.service moonlightos-usbipd.service
systemctl enable moonlightos-usbip-reconcile.path
systemctl enable moonlightos-moonlight.path moonlightos-chiaki.path moonlightos-firefox.path
systemctl enable moonlightos-reboot.path moonlightos-poweroff.path
systemctl enable moonlightos-support-export.path
systemctl enable moonlightos-configured-app.path moonlightos-osk.path
systemctl enable moonlightos-rdp.path moonlightos-rdp-secret.path
systemctl enable moonlightos-audio.service moonlightos-launcher.service \
  moonlightos-gamepad-nav.service
systemctl enable bluetooth.service moonlightos-bluetooth.service
systemctl enable moonlightos-qemu-smoke.service
systemctl enable moonlightos-hwdetect-early.service moonlightos-hwdetect.service
systemctl enable tailscaled.service moonlightos-tailscale-enroll.path moonlightos-tailscale-ssh.path

# The standard kernel supplies these modules; load them on the applicable side.
printf '%s\n' usbip_host uinput tun > /etc/modules-load.d/moonlightos-usbip.conf


# Make the appliance boot path visible to serial-only QEMU smoke tests.
ln -sf /dev/null /etc/systemd/system/getty@tty1.service
